<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/off_white"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_common" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textStyle="bold"
            android:background="@color/off_white"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:text="@string/chooseyoursensor"
            android:textColor="@color/black"
            android:textSize="35sp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
           <androidx.cardview.widget.CardView
               android:id="@+id/card_gps"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="25dp">

               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginStart="15dp"
                   android:layout_marginEnd="15dp">

                   <TextView
                       android:id="@+id/txtspeeddistance"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="15dp"
                       android:text="@string/speeddistance"
                       android:textColor="@color/Gray"
                       android:textSize="16sp"
                       android:textStyle="normal" />

                   <ImageView
                       android:id="@+id/img1"
                       android:layout_width="25dp"
                       android:layout_height="25dp"
                       android:layout_below="@+id/txtspeeddistance"
                       android:layout_marginTop="30dp"
                       android:src="@drawable/ic_power"/>

                   <ImageView
                       android:id="@+id/img3"
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:layout_below="@+id/txtgps"
                       android:layout_alignParentRight="true"
                       android:src="@drawable/ic_checkboxchecked"/>

                   <ImageView
                       android:id="@+id/img2"
                       android:layout_width="50dp"
                       android:layout_height="30dp"
                       android:layout_below="@+id/txtgps"
                       android:layout_toEndOf="@+id/img1"
                       android:layout_marginStart="15dp"
                       android:layout_marginTop="5dp"
                       android:src="@drawable/satelite"/>

                   <TextView
                       android:id="@+id/txtgps"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="15dp"
                       android:layout_marginTop="25dp"
                       android:layout_toEndOf="@+id/img1"
                       android:layout_below="@+id/txtspeeddistance"
                       android:text="@string/gpssatellitesfound"
                       android:textColor="@color/black"
                       android:textSize="16sp"
                       android:textStyle="normal" />

                   <View
                       android:layout_width="match_parent"
                       android:layout_height="1dp"
                       android:layout_marginTop="15dp"
                       android:layout_marginBottom="10dp"
                       android:layout_below="@+id/img2"
                       android:background="@color/Gray"/>


               </RelativeLayout>
           </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/lay_Skip_go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:background="@color/off_white"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvskip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_btn"
                    android:backgroundTint="@color/DarkBlue"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:text="@string/skip"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvgo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_btn"
                    android:backgroundTint="@color/green"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:text="@string/go"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />


            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>
</layout>