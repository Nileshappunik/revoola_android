<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_Box"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:layout_margin="20dp"
            android:background="@drawable/rl_filter_border_overview">

            <TextView
                android:id="@+id/BoxTextFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:textAlignment="center"
                android:textColor="@color/AppBlackColor" />

            <TextView
                android:id="@+id/BoxTextSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:text="DD/MM/YY"
                android:layout_below="@+id/BoxTextFirst"
                android:textColor="@color/AppBlackColor"/>


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/layout_Box_Type"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_margin="20dp"
            android:background="@drawable/rl_filter_border_overview">

            <TextView
                android:id="@+id/BoxText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:textAlignment="center"
                android:textColor="@color/AppBlackColor" />

        </RelativeLayout>
    </RelativeLayout>


</layout>