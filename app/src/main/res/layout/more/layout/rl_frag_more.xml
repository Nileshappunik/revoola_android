<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txt_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:text="@string/more"
            android:textColor="@color/AppBlackColor"
            android:textSize="26sp"
            android:fontFamily="@font/omnes_semibold_regular" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:weightSum="2"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_schdualedclasses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp">
                    <ImageView
                        android:id="@+id/icon_schdual"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_calendar_today"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textAllCaps="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/icon_schdual"
                        android:text="@string/schduledclasses"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_notification"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp">
                    <ImageView
                        android:id="@+id/icon_notification"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_notifications"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textAllCaps="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/icon_notification"
                        android:text="@string/notifications"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            android:background="@color/AppLightGrayColor"/>

        <include
            android:id="@+id/lay_account"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_setting"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_changepassword"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_help"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_syncwatchdara"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_restorepurchase"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_requesttodeletedata"
            layout="@layout/rl_common_image_text_image_rl" />

        <include
            android:id="@+id/lay_signout"
            layout="@layout/rl_common_image_text_image_rl" />

    </LinearLayout>
</layout>