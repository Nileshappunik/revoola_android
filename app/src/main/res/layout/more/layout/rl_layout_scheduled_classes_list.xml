<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="10dp"
            app:cardCornerRadius="5dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_user"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"
                            app:shapeAppearance="@style/CornerRound"
                            android:src="@drawable/sample_user"/>

                        <TextView
                            android:id="@+id/txt_organiser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:layout_toEndOf="@+id/img_user"
                            android:text="Orgainser"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/txt_usernam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_user"
                            android:layout_below="@+id/txt_organiser"
                            android:text="dhruv90"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="14sp"/>

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_calender"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_calendar_today"/>

                        <TextView
                            android:id="@+id/txt_missed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_calender"
                            android:textAllCaps="true"
                            android:text="Missed"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppZone7Color"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/txt_misseddate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_calender"
                            android:layout_below="@+id/txt_missed"
                            android:fontFamily="@font/omnes_regular"
                            android:text="29 Apr 06:57 Pm"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="14sp"/>

                    </RelativeLayout>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:id="@+id/img_big_full"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/body_top"/>
                    <TextView
                        android:id="@+id/txt_with"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/AppWhiteColor"
                        android:text="with"
                        android:textAllCaps="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="10dp"
                        android:layout_alignParentBottom="true"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txt_with_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/AppWhiteColor"
                        android:text="Alena"
                        android:textAllCaps="true"
                        android:layout_toEndOf="@+id/txt_with"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:layout_alignParentBottom="true"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txt_image_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/AppWhiteColor"
                        android:text="Balance Your Body"
                        android:textAllCaps="true"
                        android:layout_above="@+id/txt_with"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:textSize="26sp"/>

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:weightSum="2"
                    android:orientation="horizontal">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_watch"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_duration"/>

                        <TextView
                            android:id="@+id/txt_watchtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@+id/img_watch"
                            android:textAllCaps="true"
                            android:text="10 mins class"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="12sp"/>
                    </RelativeLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/AppMainBGColor"/>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_easy"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/txt_easy"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_easy"/>

                        <TextView
                            android:id="@+id/txt_easy"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:text="Beginner"
                            android:textAllCaps="true"
                            android:textColor="@color/AppMainColor"
                            android:textSize="12sp"/>

                    </RelativeLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/AppMainBGColor"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_warmup"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_warmuptime"/>

                        <TextView
                            android:id="@+id/txt_warmup_min"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:layout_toEndOf="@+id/img_warmup"
                            android:text="min"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txt_warmup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_warmup"
                            android:layout_below="@+id/txt_warmup_min"
                            android:text="warmup"
                            android:textAllCaps="true"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="12sp"/>

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_workout"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_work_time"/>

                        <TextView
                            android:id="@+id/txt_workout_min"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:layout_toEndOf="@+id/img_workout"
                            android:text="min"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txt_workout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:layout_toEndOf="@+id/img_workout"
                            android:layout_below="@+id/txt_workout_min"
                            android:text="workout"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="12sp"/>

                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_cooldown"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_cooldown_time"/>

                        <TextView
                            android:id="@+id/txt_cooldown_min"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/img_cooldown"
                            android:text="min"
                            android:textAllCaps="true"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txt_cooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:layout_toEndOf="@+id/img_cooldown"
                            android:layout_below="@+id/txt_cooldown_min"
                            android:text="cooldown"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="12sp"/>

                    </RelativeLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="9dp"
                    android:background="@color/AppWhiteColor"/>

            </LinearLayout>


        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</layout>