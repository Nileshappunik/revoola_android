<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
            android:layout_marginBottom="20dp">
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_chevron_left"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_centerHorizontal="true"
                android:text="@string/account"
                android:textAllCaps="true"
                android:textColor="@color/AppBlackColor"
                android:textSize="26sp"
                android:fontFamily="@font/omnes_semibold_regular" />
        </RelativeLayout>

        <include
            android:id="@+id/inlayPremiumUser"
            layout="@layout/rl_common_account_layout" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:backgroundTint="@color/AppMainColor"
                android:background="@drawable/full_round"
                android:gravity="center"
                android:text="@string/continuel"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:textSize="16sp"
                android:textColor="@color/AppWhiteColor"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:cardCornerRadius="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="25dp">

                        <include
                            android:id="@+id/relay_sinceuser"
                            layout="@layout/rl_common_account_layout" />

                        <TextView
                            android:id="@+id/txt_unlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/unlockrevoolapremium"
                            android:layout_marginTop="4dp"
                            android:textSize="20sp"
                            android:fontFamily="@font/omnes_semibold_regular"
                            android:textColor="@color/AppBlackColor"
                            android:layout_marginStart="10dp"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/AppMainColor"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginStart="10dp"/>

                        <include
                            android:id="@+id/relay_1"
                            layout="@layout/rl_common_account_layout" />
                        <include
                            android:id="@+id/relay_2"
                            layout="@layout/rl_common_account_layout" />

                        <include
                            android:id="@+id/relay_3"
                            layout="@layout/rl_common_account_layout" />

                        <include
                            android:id="@+id/relay_4"
                            layout="@layout/rl_common_account_layout" />

                        <include
                            android:id="@+id/relay_5"
                            layout="@layout/rl_common_account_layout" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/txt_freeonemonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/freeonemonthtrial"
                                android:textSize="18sp"
                                android:textColor="@color/AppBlackColor"/>
                            <TextView
                                android:id="@+id/txt_dollarsign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dollarsign"
                                android:textSize="22sp"
                                android:fontFamily="@font/omnes_semibold_regular"
                                android:textColor="@color/AppMainColor"
                                android:layout_marginStart="1dp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/txt_tryfreeonemonth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textAlignment="center"
                            android:text="@string/tryfreeonemonth"
                            android:textSize="18sp"
                            android:textColor="@color/AppBlackColor"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:id="@+id/txt_havepromocode"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/AppDarkGrayColor"
                            android:layout_marginTop="30dp"
                            android:background="@drawable/full_round"
                            android:gravity="center"
                            android:text="@string/havepromocode"
                            android:textSize="18sp"
                            android:textColor="@color/AppWhiteColor"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:id="@+id/txt_permonthcost"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/AppMainColor"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/full_round"
                            android:gravity="center"
                            android:text="@string/permonthcost"
                            android:textSize="18sp"
                            android:textColor="@color/AppWhiteColor"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:id="@+id/txt_or"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/or"
                            android:textSize="18sp"
                            android:textColor="@color/AppBlackColor"/>
                        <TextView
                            android:id="@+id/txt_continuewithfree"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/AppBottomGrayColor"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/full_round"
                            android:gravity="center"
                            android:text="@string/continuewithfree"
                            android:textSize="18sp"
                            android:textColor="@color/AppWhiteColor"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:id="@+id/txt_bytappingsubscribeyourpayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:textAlignment="center"
                            android:text="@string/bytappingsubscribeyourpayment"
                            android:textSize="18sp"
                            android:textColor="@color/AppBlackColor"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

        </ScrollView>

    </LinearLayout>
</layout>