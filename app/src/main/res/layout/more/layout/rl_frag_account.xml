<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppLightGrayColor"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
            android:layout_marginBottom="0dp">
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_chevron_left"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/account"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:textColor="@color/AppBlackColor"
                android:textSize="18sp"
                android:fontFamily="@font/omnes_regular" />
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:src="@drawable/ic_revoola_logo"
                app:tint="@color/AppMainColor"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="65dp"
                app:cardCornerRadius="0dp"
                android:layout_margin="10dp"
                app:cardElevation="10dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="14sp"
                    android:paddingStart="10dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/login_btn"
                    android:text="Just sign in to convert your guest user and get all the Premium features of Revoola"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="65dp"
                app:cardCornerRadius="5dp"
                android:layout_margin="10dp"
                app:cardElevation="10dp">
                <TextView
                    android:id="@+id/txt_Facebookaccount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:drawableLeft="@drawable/ic_facebook"
                    android:drawablePadding="10dp"
                    android:textSize="16sp"
                    android:textAllCaps="true"
                    android:paddingLeft="10dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/login_btn"
                    android:text="@string/facebookaccount"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="65dp"
                app:cardCornerRadius="5dp"
                android:layout_margin="10dp"
                app:cardElevation="10dp">
                <TextView
                    android:id="@+id/txt_Googleaccount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:drawableLeft="@drawable/ic_google"
                    android:drawablePadding="10dp"
                    android:textSize="16sp"
                    android:textAllCaps="true"
                    android:paddingLeft="10dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/login_btn"
                    android:text="@string/googleaccount"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="65dp"
                app:cardCornerRadius="5dp"
                android:layout_margin="10dp"
                app:cardElevation="10dp">
                <TextView
                    android:id="@+id/txt_emailaccount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:drawableLeft="@drawable/ic_email"
                    android:drawableTint="@color/AppMainColor"
                    android:drawablePadding="10dp"
                    android:textSize="16sp"
                    android:textAllCaps="true"
                    android:paddingLeft="10dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/login_btn"
                    android:text="@string/emailaccount"/>
            </androidx.cardview.widget.CardView>



        </LinearLayout>
    </LinearLayout>
</layout>