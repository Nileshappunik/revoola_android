<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/off_white"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        android:layout_margin="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_user"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/classes"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txt_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layout_constraintLeft_toRightOf="@+id/img_user"
                android:text="@string/hidhruv"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="@dimen/text_title_size"/>

            <TextView
                android:id="@+id/txt_userdatetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="15dp"
                app:layout_constraintLeft_toRightOf="@+id/img_user"
                app:layout_constraintTop_toBottomOf="@+id/txt_username"
                android:text="23/04/2024 16:57"
                android:textStyle="normal"
                android:textColor="@color/Gray"
                android:textSize="@dimen/text_size"/>

            <ImageView
                android:id="@+id/img_threedot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fd_options_gray"
                app:tint="@color/Gray"
                app:layout_constraintTop_toBottomOf="@+id/txt_username"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/img_myride"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/fd_ride_green"
                app:layout_constraintTop_toBottomOf="@+id/img_user"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txt_myride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/img_user"
                app:layout_constraintLeft_toRightOf="@+id/img_myride"
                android:text="@string/myride"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="@dimen/text_main_title_size"/>

            <include
                android:id="@+id/lay_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/common_image_title_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/img_myride"
                app:layout_constraintStart_toStartOf="parent"/>

            <include
                android:id="@+id/lay_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/common_image_title_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/lay_time"
                app:layout_constraintStart_toStartOf="parent"/>

            <include
                android:id="@+id/lay_assumedeffort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/common_image_title_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/lay_calories"
                app:layout_constraintStart_toStartOf="parent"/>

            <include
                android:id="@+id/lay_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/common_image_title_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/lay_assumedeffort"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:id="@+id/img_nain"
                android:layout_width="150dp"
                android:layout_height="200dp"
                app:layout_constraintTop_toBottomOf="@+id/txt_myride"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="10dp"
                android:scaleType="fitXY"
                app:layout_constraintLeft_toRightOf="@+id/lay_assumedeffort"
                android:src="@drawable/yourway"/>

            <ImageView
                android:id="@+id/img_thum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fd_thumbs_gray"
                app:tint="@color/Gray"
                android:layout_marginTop="30dp"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toBottomOf="@+id/img_nain"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:visibility="gone"
                android:textColor="@color/Gray"
                android:layout_marginTop="30dp"
                android:layout_marginStart="5dp"
                app:layout_constraintTop_toBottomOf="@+id/img_nain"
                app:layout_constraintStart_toEndOf="@+id/img_thum"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/img_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fd_comment_gray"
                app:tint="@color/Gray"
                android:layout_marginTop="30dp"
                android:layout_marginRight="30dp"
                app:layout_constraintTop_toBottomOf="@+id/img_nain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:visibility="gone"
                android:textColor="@color/Gray"
                android:layout_marginTop="30dp"
                android:layout_marginStart="5dp"
                app:layout_constraintTop_toBottomOf="@+id/img_nain"
                app:layout_constraintStart_toEndOf="@+id/img_chat"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>