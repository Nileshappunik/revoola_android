<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@color/transparent_dialog"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/square_border_error"
            android:backgroundTint="@color/AppLightGrayColor">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:textAlignment="center"
                android:layout_centerInParent="true"
                android:text="@string/weneedtosendverificationcode"
                android:textColor="@color/AppDarkGrayColor"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/tvYes"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/square_border_error"
                android:backgroundTint="@color/AppMainColor"
                android:gravity="center"
                android:textAllCaps="true"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:text="@string/ok"
                android:textColor="@color/AppWhiteColor"
                android:textSize="16sp"
                android:fontFamily="@font/omnes_regular" />

        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>