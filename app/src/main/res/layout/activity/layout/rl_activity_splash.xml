<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:paddingLeft="5dp"
      android:paddingRight="5dp"
      android:background="@drawable/wellcome"
      android:orientation="vertical">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_revoola_logo"
        app:tint="@color/AppBlackColor"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        app:cardElevation="0dp">
      <TextView
          android:id="@+id/txt_fullrevoolaexperience"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:textSize="25sp"
          android:textAlignment="center"
          android:textAllCaps="true"
          android:fontFamily="@font/omnes_semibold_regular"
          android:textColor="@color/AppMainColor"
          android:text="@string/fullrevoolaexperience"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        android:layout_margin="5dp"
        app:cardElevation="0dp">
      <TextView
          android:id="@+id/txt_justhereforaquickpeak"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:textSize="25sp"
         android:textAllCaps="true"
          android:fontFamily="@font/omnes_semibold_regular"
          android:textColor="@color/AppMainColor"
          android:textAlignment="center"
          android:text="@string/justhereforaquickpeak"/>
    </androidx.cardview.widget.CardView>




  </LinearLayout>
</layout>