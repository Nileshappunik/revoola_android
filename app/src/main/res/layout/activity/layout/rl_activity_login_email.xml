<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar_login"
            layout="@layout/rl_login_toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textAllCaps="true"
            android:fontFamily="@font/omnes_regular"
            android:textColor="@color/AppDarkGrayColor"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="25dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_email"/>

            <EditText
                android:id="@+id/etemailid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:inputType="textEmailAddress"
                android:textColor="@color/AppBlackColor"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppLightGrayColor"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/password"
            android:textAllCaps="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/omnes_regular"
            android:textColor="@color/AppDarkGrayColor"
            android:layout_marginStart="20dp"
            android:textSize="16sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="25dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_security"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                android:background="@null"
                android:inputType="textPassword"
                android:textColor="@color/AppBlackColor"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppLightGrayColor"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvLoginNoClick"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight= "20dp"
            android:layout_marginTop= "50dp"
            android:background="@drawable/round_border_login"
            android:gravity="center"
            android:visibility="visible"
            android:text="@string/continuel"
            android:textColor="@color/AppDarkGrayColor"
            android:textSize="16sp"
            android:fontFamily="@font/omnes_regular" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight= "20dp"
            android:layout_marginTop= "50dp"
            android:visibility="gone"
            android:background="@drawable/round_border_login_green"
            android:gravity="center"
            android:text="@string/continuel"
            android:textColor="@color/AppWhiteColor"
            android:textSize="16sp"
            android:fontFamily="@font/omnes_regular" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txt_forhotpassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgotpassword"
                    android:textColor="@color/AppBlackColor"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/omnes_regular" />

                <TextView
                    android:id="@+id/txt_clickme"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:text="@string/clickhere"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/AppWhiteColor"
                    android:background="@drawable/round_border"
                    app:backgroundTint="@color/AppMainColor"
                    android:textSize="14sp"
                    android:fontFamily="@font/omnes_semibold_regular" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</layout>