<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_videoplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppBlackColor">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:weightSum="2"
            android:orientation="horizontal">
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:background="@null">
                <RelativeLayout
                    android:id="@+id/linear_heart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null">
                    <RelativeLayout
                        android:id="@+id/rl_heartrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.example.myfirstapp.ui.RLCircularProgressBar
                            android:id="@+id/circularProgressBar"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_centerHorizontal="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:text="20%"
                            android:layout_marginTop="30dp"
                            android:layout_centerHorizontal="true"
                            android:textAlignment="center"
                            android:textColor="@color/AppWhiteColor"
                            android:fontFamily="@font/omnes_bold"/>

                    </RelativeLayout>

                    <include
                        android:id="@+id/inlay_effort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rl_heartrate"
                        layout="@layout/rl_common_start_class_with_sensor"/>
                    <include
                        android:id="@+id/inlay_calories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_effort"
                        layout="@layout/rl_common_start_class_with_sensor"/>
                    <include
                        android:id="@+id/inlay_heartrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_calories"
                        layout="@layout/rl_common_start_class_with_sensor"/>
                    <include
                        android:id="@+id/inlay_cadence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_heartrate"
                        layout="@layout/rl_common_start_class_with_sensor"/>

                    <include
                        android:id="@+id/inlay_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_cadence"
                        layout="@layout/rl_common_start_class_with_sensor"/>
                </RelativeLayout>
            </ScrollView>
            <RelativeLayout
                android:id="@+id/reclay_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_play_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="visible"
            android:orientation="horizontal"
            android:gravity="center">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_pause_resume"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_pause_button"/>
                <TextView
                    android:id="@+id/txt_pause_resume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="18sp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="PAUSE"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_stop"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_stop_button"/>
                <TextView
                    android:id="@+id/txt_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="18sp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="STOP"/>
            </LinearLayout>
        </LinearLayout>
      <include
          android:id="@+id/inlay_countdown"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="visible"
          layout="@layout/rl_classes_count_down_body"/>
    </RelativeLayout>

</layout>
