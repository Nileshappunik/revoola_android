<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
            android:layout_marginBottom="0dp">
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_chevron_left"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_centerHorizontal="true"
                android:text="@string/account"
                android:textAllCaps="true"
                android:textColor="@color/AppBlackColor"
                android:textSize="26sp"
                android:fontFamily="@font/omnes_semibold_regular" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <include
                    android:id="@+id/inlayPremiumUser"
                    layout="@layout/rl_common_account_layout" />

                <LinearLayout
                    android:id="@+id/subscribe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/inlayPremiumUser"
                    android:visibility="gone"
                    android:layout_marginBottom="25dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_unlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        android:textAllCaps="true"
                        android:fontFamily="@font/aptos_regular"
                        android:text="@string/unlockrevoolapremium"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="22sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="100dp"
                        android:background="@color/AppDarkGrayColor" />

                    <include
                        android:id="@+id/relay_1"
                        layout="@layout/rl_common_account_layout" />

                    <include
                        android:id="@+id/relay_2"
                        layout="@layout/rl_common_account_layout" />

                    <include
                        android:id="@+id/relay_3"
                        layout="@layout/rl_common_account_layout" />

                    <include
                        android:id="@+id/relay_4"
                        layout="@layout/rl_common_account_layout" />

                    <include
                        android:id="@+id/relay_5"
                        layout="@layout/rl_common_account_layout" />

                    <TextView
                        android:id="@+id/txt_freeonemonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:fontFamily="@font/aptos_regular"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/freeonemonthtrial"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="0dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_dollarsign"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:fontFamily="@font/omnes_semibold_regular"
                            android:textColor="@color/AppMainColor"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/txt_tryfreeonemonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/aptos_regular"
                            android:text="@string/tryfreeonemonth"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_havepromocode"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="true"
                        android:background="@drawable/full_round"
                        android:backgroundTint="@color/AppBlackColor"
                        android:gravity="center"
                        android:text="@string/havepromocode"
                        android:textColor="@color/AppWhiteColor"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnSubscribe"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="true"
                        android:background="@drawable/full_round"
                        android:backgroundTint="@color/AppMainColor"
                        android:gravity="center"
                        android:text="@string/permonthcost"
                        android:textColor="@color/AppWhiteColor"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txt_or"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/or"
                        android:textAllCaps="true"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txt_continuewithfree"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="true"
                        android:background="@drawable/full_round"
                        android:backgroundTint="@color/AppBottomGrayColor"
                        android:gravity="center"
                        android:text="@string/continuewithfree"
                        android:textColor="@color/AppWhiteColor"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txt_bytappingsubscribeyourpayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:fontFamily="@font/aptos_regular"
                        android:textAlignment="center"
                        android:textAllCaps="true"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_Privacy_Policy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:textAllCaps="true"
                            android:fontFamily="@font/aptos_regular"
                            android:text="@string/privacy_policy"
                            android:textColor="@color/AppMainColor"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/txt_Terms_of_Use"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:textAllCaps="true"
                            android:fontFamily="@font/aptos_regular"
                            android:text="@string/term_of_use"
                            android:textColor="@color/AppMainColor"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </ScrollView>

    </LinearLayout>
</layout>