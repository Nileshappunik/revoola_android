<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_Main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppNEWBGColor">

        <LinearLayout
            android:id="@+id/tv_SessionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include
                android:id="@+id/inlayTop"
                layout="@layout/rl_layout_common_start_top"/>


            <RelativeLayout
                android:id="@+id/relay_OverviewName"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:visibility="visible"
                android:background="@color/AppNEWBGColor">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_user"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/sample_user"/>
                    <!--android:src="@drawable/sample_user" />-->

                <TextView
                    android:id="@+id/txt_username"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_vertical"
                    android:textSize="20sp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="@string/hidhruv"
                    android:layout_toEndOf="@+id/img_user"
                    android:textColor="@color/AppWhiteColor" />
                <TextView
                    android:id="@+id/txt_goodtoseeyou"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/img_user"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="20dp"
                    android:textSize="20sp"
                    android:text="@string/goodtoseeyou"
                    android:textColor="@color/AppWhiteColor"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <LinearLayout
                    android:id="@+id/lay_youractivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:gravity="bottom"
                    android:layout_below="@+id/txt_goodtoseeyou"
                    android:layout_above="@+id/activityView"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/txt_youractivity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="20sp"
                        android:text="@string/youractivity"
                        android:textColor="@color/AppMainColor"
                        android:fontFamily="@font/omnes_semibold_regular" />

                    <TextView
                        android:id="@+id/txt_Current_Month"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="20sp"
                        android:textAllCaps="true"
                        android:paddingStart="20dp"
                        android:text="AUG 2024"
                        android:textColor="@color/AppWhiteColor"
                        android:fontFamily="@font/omnes_semibold_regular" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activityView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    android:layout_alignParentBottom="true"
                    android:weightSum="2">
                    <View
                        android:id="@+id/view_even"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@color/AppMainColor"/>
                    <View
                        android:id="@+id/view_odd"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@color/AppMainColor"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_SessionTop">
            <RelativeLayout
                android:id="@+id/swipeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/txt_totalsession_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/aptos_bold"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="30sp" />
                <TextView
                    android:id="@+id/txt_totalsession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:visibility="visible"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@+id/txt_totalsession_number"
                    android:fontFamily="@font/aptos_bold"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="30sp" />

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    android:layout_below="@+id/txt_totalsession_number"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_below="@+id/webView"/>


            </RelativeLayout>

        </ScrollView>

        <include
            android:id="@+id/inlay_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/filter_margin_end"
            android:layout_marginBottom="@dimen/filter_margin_bottom"
            layout="@layout/rl_layout_filter_bottom_mrnu"/>


    </RelativeLayout>
</layout>