<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <include
            android:id="@+id/inlayTop"
            layout="@layout/rl_layout_common_start_top"/>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/inlayTop">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/txt_totalsession_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="30sp" />
                <TextView
                    android:id="@+id/txt_totalsession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:visibility="visible"
                    android:layout_toEndOf="@+id/txt_totalsession_number"
                    android:text="@string/session"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="30sp" />

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/txt_totalsession_number"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop= "10dp"
                    android:layout_below="@+id/webView"/>

            </RelativeLayout>

        </ScrollView>

        <include
            android:id="@+id/inlay_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/filter_margin_end"
            android:layout_marginBottom="@dimen/filter_margin_bottom"
            layout="@layout/rl_layout_filter_bottom_mrnu"/>

        <RelativeLayout
            android:id="@+id/layFlter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/full_round_green">
            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                app:tint="@color/AppWhiteColor"
                android:src="@drawable/ic_filter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filters"
                android:fontFamily="@font/aptos_regular"
                android:layout_marginStart="10dp"
                android:textSize="16sp"
                android:layout_centerVertical="true"
                android:textColor="@color/AppWhiteColor"
                android:layout_toEndOf="@+id/ivFilter"/>
        </RelativeLayout>

    </RelativeLayout>
</layout>