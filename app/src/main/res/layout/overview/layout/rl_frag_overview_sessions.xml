<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="@string/session"
            android:textAlignment="center"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:layout_toStartOf="@+id/ivFilter"
            android:layout_toEndOf="@+id/ivBack"/>

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_filter"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle_session_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop= "15dp"
            android:layout_marginStart="16dp"
            android:layout_below="@+id/iv_title"/>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/recycle_session_title">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/txt_totalsession_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:paddingEnd="2dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="36sp" />
                <TextView
                    android:id="@+id/txt_totalsession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="10dp"
                    android:paddingStart="2dp"
                    android:visibility="gone"
                    android:layout_marginTop="20dp"
                    android:layout_toEndOf="@+id/txt_totalsession_number"
                    android:text="@string/session"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="24sp" />

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/txt_totalsession_number"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop= "10dp"
                    android:layout_below="@+id/webView"/>

            </RelativeLayout>

        </ScrollView>

    </RelativeLayout>
</layout>