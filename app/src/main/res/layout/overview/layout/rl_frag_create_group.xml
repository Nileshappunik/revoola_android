<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">
        <include
            android:id="@+id/toolbar"
            layout="@layout/rl_toolbar_common" />

        <View
            android:id="@+id/view_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:background="@color/AppBlack10Color"/>


        <RelativeLayout
            android:id="@+id/ivNameImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:layout_below="@+id/view_1">

            <ImageView
                android:id="@+id/ivGroupImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_photo1"/>

            <EditText
                android:id="@+id/ivGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/ivGroupImage"
                android:layout_marginStart="20dp"
                android:textSize="14sp"
                android:layout_centerVertical="true"
                android:hint="Type Group Name Here"
                android:padding="10dp"
                android:textColorHint="@color/AppTextLightGrayColor"
                android:background="@drawable/square_border_light"/>

        </RelativeLayout>


        <TextView
            android:id="@+id/tvselectedCount"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@color/AppLightGrayColor"
            android:textColor="@color/black"
            android:textSize="@dimen/button_text_size"
            android:layout_below="@+id/ivNameImage"
            android:fontFamily="@font/omnes_semibold_regular" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ivFriendList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tvselectedCount"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvCreateClick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_size"
            android:layout_marginLeft="15dp"
            android:layout_marginRight= "15dp"
            android:layout_marginBottom="10dp"
            android:visibility="visible"
            android:layout_alignParentBottom="true"
            android:background="@drawable/round_border_login_green"
            android:gravity="center"
            android:textAllCaps="true"
            android:text="@string/create"
            android:textColor="@color/AppWhiteColor"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            android:fontFamily="@font/omnes_regular" />


    </RelativeLayout>

</layout>