<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/linear_overview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppNEWBGColor"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/AppNEWBGColor">
            <ImageView
                android:id="@+id/logo"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_revoola_logo"
                app:tint="@color/AppWhiteColor" />
            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                app:tint="@color/AppWhiteColor"
                android:src="@drawable/ic_notifications" />

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_top"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_user"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/sample_user" />

            <TextView
                android:id="@+id/txt_username"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:text="@string/hidhruv"
                android:layout_toEndOf="@+id/img_user"
                android:textColor="@color/AppWhiteColor" />
            <!-- keepgoodtoseeyou-->
            <TextView
                android:id="@+id/txt_goodtoseeyou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/img_user"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                android:textSize="22sp"
                android:text="@string/goodtoseeyou"
                android:textColor="@color/AppWhiteColor"
                android:fontFamily="@font/omnes_semibold_regular" />

            <TextView
                android:id="@+id/txt_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_goodtoseeyou"
                android:textSize="14sp"
                android:background="@drawable/round_green"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textAllCaps="true"
                android:textColor="@color/AppWhiteColor"
                android:fontFamily="@font/omnes_semibold_regular"/>

            <TextView
                android:id="@+id/txt_youractivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_month"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:textSize="24sp"
                android:text="@string/youractivity"
                android:textColor="@color/AppWhiteColor"
                android:fontFamily="@font/omnes_semibold_regular" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:paddingBottom="10dp"
            android:weightSum="4">
            <include
                android:id="@+id/inlay_effort"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="15dp"
                layout="@layout/rl_common_card_overview"/>

            <include
                android:id="@+id/inlay_session"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/overviewcadtop"
                layout="@layout/rl_common_card_overview"
                android:layout_below="@+id/inlay_effort"/>

            <include
                android:id="@+id/inlay_totalcalories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/overviewcadtop"
                layout="@layout/rl_common_card_overview"
                android:layout_below="@+id/inlay_session"/>

            <include
                android:id="@+id/inlay_distance"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/overviewcadtop"
                layout="@layout/rl_common_card_overview"
                android:layout_below="@+id/inlay_totalcalories"/>


        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:visibility="visible"
            android:background="@color/AppNEWBGColor" />

    </LinearLayout>
</layout>

