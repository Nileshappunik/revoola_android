<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppNEWBGColor">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppNEWBGColor"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"
                android:background="@color/AppNEWBGColor">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginStart="100dp"
                    android:layout_marginEnd="100dp"
                    android:src="@drawable/ic_revoola_logo"
                    app:tint="@color/AppWhiteColor" />
                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    app:tint="@color/AppWhiteColor"
                    android:src="@drawable/ic_notifications"
                    android:visibility="visible" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relay_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_user"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/wellcome" />

                <TextView
                    android:id="@+id/txt_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="16sp"
                    android:layout_marginVertical="15dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:layout_marginTop="5dp"
                    android:layout_toEndOf="@+id/img_user"
                    android:textColor="@color/AppWhiteColor" />

                <TextView
                    android:id="@+id/txt_goodtoseeyou"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/img_user"
                    android:layout_marginTop="5dp"
                    android:textSize="24sp"
                    android:text="@string/keepgoodtoseeyou"
                    android:textColor="@color/AppWhiteColor"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <TextView
                    android:id="@+id/txt_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txt_goodtoseeyou"
                    android:layout_marginTop="20dp"
                    android:textSize="16sp"
                    android:background="@drawable/round_green"
                    android:padding="5dp"
                    android:textColor="@color/AppWhiteColor"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <TextView
                    android:id="@+id/txt_youractivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txt_month"
                    android:layout_marginTop="5dp"
                    android:textSize="24sp"
                    android:text="@string/youractivity"
                    android:textColor="@color/AppWhiteColor"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <include
                    android:id="@+id/inlay_effort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    layout="@layout/rl_common_card_overview"
                    android:layout_below="@+id/txt_youractivity"/>

                <include
                    android:id="@+id/inlay_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/overviewcadtop"
                    layout="@layout/rl_common_card_overview"
                    android:layout_below="@+id/inlay_effort"/>

                <include
                    android:id="@+id/inlay_totalcalories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/overviewcadtop"
                    layout="@layout/rl_common_card_overview"
                    android:layout_below="@+id/inlay_session"/>

                <include
                    android:id="@+id/inlay_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/overviewcadtop"
                    layout="@layout/rl_common_card_overview"
                    android:layout_below="@+id/inlay_totalcalories"/>

            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:visibility="visible"
                android:background="@color/AppNEWBGColor" />

        </LinearLayout>
    </ScrollView>
</layout>