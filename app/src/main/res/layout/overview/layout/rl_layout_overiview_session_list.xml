<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="0dp">

        <ImageView
            android:id="@+id/imgsessionimage"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/fd_active_time_green" />

        <TextView
            android:id="@+id/txtsessiontitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LONGEST SESSION"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/imgsessionimage"
            android:textColor="@color/AppBlackColor"
            android:textSize="12sp"/>


        <TextView
            android:id="@+id/txt_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:layout_below="@+id/txtsessiontitle"
            android:textSize="24sp"
            android:text="30m"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:layout_toEndOf="@+id/imgsessionimage"/>

        <View
            android:id="@+id/view_even"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_alignParentBottom="true"
            android:background="@color/AppMainColor"/>
        <View
            android:id="@+id/view_odd"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentBottom="true"
            android:background="@color/AppMainColor"/>
    </RelativeLayout>

</layout>