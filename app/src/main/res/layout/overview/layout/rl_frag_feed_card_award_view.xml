<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppLightGrayColor">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:text="AWARDS"
            android:textAlignment="textStart"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:layout_below="@+id/ivBack"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_commentList_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppWhiteColor"
            android:paddingTop="20dp"
            android:layout_below="@+id/iv_title"
            tools:listitem="@layout/rl_item_award"/>

    </RelativeLayout>

</layout>