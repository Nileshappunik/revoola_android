<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_common" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/off_white" />


        <TextView
            android:id="@+id/tvpassupdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
           android:textAlignment="center"
            android:text="@string/typeofchallenge"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">
            <include
                android:id="@+id/relay_steps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
            <include
                android:id="@+id/relay_effort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal">
            <include
                android:id="@+id/relay_calories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
            <include
                android:id="@+id/relay_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal">
            <include
                android:id="@+id/relay_climbed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
            <include
                android:id="@+id/relay_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:visibility="visible"
                layout="@layout/common_challenges_type_card"/>
        </LinearLayout>

    </LinearLayout>
</layout>