<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp">

        <RelativeLayout
            android:id="@+id/ivToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">
            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/availablefilter"
                android:textAllCaps="true"
                android:textColor="@color/AppBlackColor"
                android:textSize="22sp"
                android:fontFamily="@font/omnes_semibold_regular" />

            <ImageView
                android:id="@+id/txtx_cancle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@drawable/ic_times_close"
                app:tint="@color/AppMainColor"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <ExpandableListView
            android:id="@+id/expandableListViewFilter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dividerHeight="0dp"
            android:layout_below="@+id/ivToolbar"
            android:layout_above="@+id/txt_show_all_classes"
            android:divider="@android:color/transparent"
            android:groupIndicator="@null"/>

        <TextView
            android:id="@+id/txt_show_all_classes"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight= "20dp"
            android:layout_marginTop= "20dp"
            android:background="@drawable/round_border_login_green"
            android:gravity="center"
            android:textAllCaps="true"
            android:layout_alignParentBottom="true"
            android:text="@string/showallclasses"
            android:textColor="@color/AppWhiteColor"
            android:textSize="16sp"
            android:fontFamily="@font/omnes_semibold_regular" />

    </RelativeLayout>
</layout>
