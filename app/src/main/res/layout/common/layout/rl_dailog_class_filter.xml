<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="@string/availablefilter"
            android:textAllCaps="true"
            android:textColor="@color/AppBlackColor"
            android:textSize="22sp"
            android:fontFamily="@font/omnes_semibold_regular" />

        <ImageView
            android:id="@+id/txtx_cancle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="30dp"
            android:layout_marginEnd="20dp"
            android:padding="4dp"
            android:src="@drawable/ic_times_close"
            app:tint="@color/AppMainColor"
            android:layout_alignParentEnd="true"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtx_cancle"
            android:layout_above="@+id/txt_show_all_classes">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/card_instructor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/rl_common_class_filter_card" />

                <include
                    android:id="@+id/card_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    layout="@layout/rl_common_class_filter_card"
                    android:layout_below="@+id/card_instructor"/>

                <include
                    android:id="@+id/card_takenbyme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    layout="@layout/rl_common_class_filter_card"
                    android:layout_below="@+id/card_duration"/>

                <include
                    android:id="@+id/card_classtype"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    layout="@layout/rl_common_class_filter_card"
                    android:layout_below="@+id/card_takenbyme"/>
            </RelativeLayout>
        </ScrollView>

        <TextView
            android:id="@+id/txt_show_all_classes"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight= "20dp"
            android:layout_marginTop= "50dp"
            android:background="@drawable/round_border_login_green"
            android:gravity="center"
            android:textAllCaps="true"
            android:layout_alignParentBottom="true"
            android:text="@string/showallclasses"
            android:textColor="@color/AppWhiteColor"
            android:textSize="16sp"
            android:fontFamily="@font/omnes_semibold_regular" />

    </RelativeLayout>
</layout>
