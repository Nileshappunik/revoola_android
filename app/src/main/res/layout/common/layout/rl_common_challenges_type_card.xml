<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/card_chalengesst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/square_border_black">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/img_type"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/fd_steps_green" />

            <TextView
                android:id="@+id/txt_type_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/img_type"
                android:textAllCaps="true"
                android:text="@string/stepsmall"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="28sp"/>
        </RelativeLayout>


    </RelativeLayout>
</layout>