<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/relay_sensor_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null">

        <RelativeLayout
            android:id="@+id/relay_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_time"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/fd_active_time_green"
                android:layout_centerVertical="true"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/txt_progress_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:layout_marginTop="10dp"
                android:layout_toEndOf="@+id/img_time"
                android:fontFamily="@font/omnes_regular"
                android:background="@null"
                android:text="@string/time"
                android:textStyle="bold"
                android:textColor="@color/AppWhiteColor"
                android:textSize="12sp"/>


            <TextView
                android:id="@+id/txt_progress_time_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/aptos_bold"
                android:background="@null"
                android:layout_below="@+id/txt_progress_time"
                android:layout_toEndOf="@+id/img_time"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="@color/AppWhiteColor"
                android:textSize="22sp"/>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/lay_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relay_time"
            android:background="@null"
            android:visibility="gone"
            android:layout_marginStart="40dp"
            android:layout_marginTop="1dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txt_avg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/omnes_regular"
                android:background="@null"
                android:layout_marginStart="10dp"
                android:text="AVG"
                android:textStyle="bold"
                android:textColor="@color/AppLightGrayColor"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txt_avg_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aptos_bold"
                android:background="@null"
                android:layout_marginStart="10dp"
                android:text="00:00"
                android:textColor="@color/AppLightGrayColor"
                android:textSize="14sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relay_time"
            android:layout_toEndOf="@+id/lay_avg"
            android:layout_marginStart="5dp"
            android:background="@null"
            android:visibility="gone"
            android:layout_marginTop="1dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txt_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/omnes_regular"
                android:layout_marginStart="10dp"
                android:text="MAX"
                android:textStyle="bold"
                android:textColor="@color/AppLightGrayColor"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txt_max_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aptos_bold"
                android:background="@null"
                android:layout_marginStart="10dp"
                android:text="00:00"
                android:textColor="@color/AppLightGrayColor"
                android:textSize="14sp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/AppMainColor"/>
    </RelativeLayout>

</layout>