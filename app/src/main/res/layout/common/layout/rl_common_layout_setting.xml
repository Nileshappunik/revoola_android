<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_user"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="20dp">

        <TextView
            android:id="@+id/txtusertitle"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_centerVertical="true"
            android:text="@string/firstname"
            android:textColor="@color/AppTextGrayColor"
            android:textSize="16sp"/>


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_user"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:layout_toEndOf="@+id/txtusertitle"
            android:src="@drawable/sample_user"/>

        <TextView
            android:id="@+id/txt_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@+id/txtusertitle"
            android:layout_toStartOf="@+id/img_edit"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/edt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:focusable="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/img_done"
            android:layout_toEndOf="@+id/txtusertitle"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/img_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_edit"/>

        <ImageView
            android:id="@+id/img_done"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:padding="10dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_check_g_right"/>

       <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginEnd="10dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:thumbTint="@color/AppWhiteColor"
            android:checked="true"
            app:track="@drawable/custom_track"/>

        <LinearLayout
            android:id="@+id/lay_privacy"
            android:layout_width="115dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/round_border_white"
            android:backgroundTint="@color/AppPrivacyEveryOneBGColor"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img_shareimage"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_privacyeveryone"/>
            <TextView
                android:id="@+id/tvsharetitle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/everyone"
                android:layout_marginStart="5dp"
                android:textAllCaps="true"
                android:gravity="center_vertical"
                android:textColor="@color/AppPrivacyEveryOneColor"
                android:textSize="14sp"
                android:fontFamily="@font/omnes_semibold_regular" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppBlack10Color"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>
</layout>