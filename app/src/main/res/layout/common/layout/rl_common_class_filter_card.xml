<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="10dp">
                <TextView
                    android:id="@+id/txt_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instructor"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="18sp"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <LinearLayout
                    android:id="@+id/lay1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/txt_subtitle1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="Sam Rehan"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_subtitle2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="Alena"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/txt_subtitle3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="Sam Rehan"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_subtitle4"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="Alena"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/txt_subtitle5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="10"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_subtitle6"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="11"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lay4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="5dp"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/txt_subtitle7"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="17"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_subtitle8"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        android:background="@drawable/square_border_dark"
                        android:text="18"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</layout>