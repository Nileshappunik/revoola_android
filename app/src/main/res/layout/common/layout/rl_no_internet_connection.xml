<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layoutNotConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">


        <ImageView
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:src="@drawable/noconnecation" />

     <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:gravity="center"
         android:fontFamily="@font/omnes_semibold_regular"
            android:text="@string/no_conn"
            android:textColor="@color/AppBlackColor"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/check_your_connection"
            android:textColor="@color/AppBlackColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:background="@drawable/login_btn"
            android:backgroundTint="@color/AppBlackColor"
            android:elevation="10dp"
            android:gravity="center"
            android:paddingLeft="33dp"
            android:paddingTop="10dp"
            android:paddingRight="33dp"
            android:paddingBottom="10dp"
            android:text="@string/retry"
            android:textColor="@color/AppWhiteColor"
            android:textSize="18sp"
            android:fontFamily="@font/omnes_semibold_regular" />
    </LinearLayout>
</layout>