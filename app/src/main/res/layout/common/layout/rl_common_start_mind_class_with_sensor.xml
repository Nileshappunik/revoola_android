<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_sensor_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null">

        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            app:tint="@color/AppWhiteColor"
            android:src="@drawable/fd_active_time_green" />

          <TextView
            android:id="@+id/txt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/omnes_regular"
              android:textStyle="bold"
            android:background="@null"
            android:text="@string/time"
              android:layout_toEndOf="@+id/img_icon"
            android:textColor="@color/AppLightGrayColor"
            android:textSize="12sp"/>


        <TextView
            android:id="@+id/txt_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:background="@null"
            android:layout_below="@+id/txt_name"
            android:layout_toEndOf="@+id/img_icon"
            android:layout_marginStart="10dp"
            android:text="0"
            android:textColor="@color/AppWhiteColor"
            android:textSize="24sp"/>

        <View
            android:id="@+id/progress_view2"
            android:layout_width="140dp"
            android:layout_height="1dp"
            android:layout_below="@+id/txt_number"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:background="@color/AppTextGrayColor"/>

    </RelativeLayout>

</layout>