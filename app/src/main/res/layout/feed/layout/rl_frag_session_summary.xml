<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <!--android:background="@drawable/full_round"-->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="16dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="@string/winditdown"
            android:textAlignment="center"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:layout_toEndOf="@+id/ivBack"/>

        <TextView
            android:id="@+id/iv_title_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="12/04/2023 at 08:46"
            android:textAlignment="center"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/iv_title"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"
            android:layout_toEndOf="@+id/ivBack"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle_session_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop= "15dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_below="@+id/iv_title_date">
        </androidx.recyclerview.widget.RecyclerView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/recycle_session_title">
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent">
               <RelativeLayout
                   android:id="@+id/relay_summary"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="visible">

                   <androidx.viewpager.widget.ViewPager
                       android:id="@+id/viewPager_image"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:visibility="gone"
                       android:layout_marginTop="10dp" />

                   <ImageView
                       android:id="@+id/test_image"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:src="@drawable/walk"
                       android:scaleType="centerCrop"
                       android:layout_marginTop="10dp" />


                   <androidx.recyclerview.widget.RecyclerView
                       android:id="@+id/recycle_session"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:nestedScrollingEnabled="false"
                       android:layout_marginTop= "10dp"
                       android:layout_below="@+id/test_image"/>

               </RelativeLayout>
               <RelativeLayout
                   android:id="@+id/relay_analysis"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="gone">

                   <include
                       android:id="@+id/include_effort"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       layout="@layout/rl_feed_analysis_layout_map"/>


                   <include
                       android:id="@+id/include_elevation"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_effort"
                       layout="@layout/rl_feed_analysis_layout_map"/>

                   <include
                       android:id="@+id/include_speed"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_elevation"
                       layout="@layout/rl_feed_analysis_layout_map"/>

                   <include
                       android:id="@+id/include_pace"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_speed"
                       layout="@layout/rl_feed_analysis_layout_map"/>


               </RelativeLayout>
               <RelativeLayout
                   android:id="@+id/relay_effort"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="gone">
                   <WebView
                       android:id="@+id/webView_effort"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"/>
                   <LinearLayout
                       android:id="@+id/lay_effort_tit"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop= "10dp"
                       android:layout_marginStart="15dp"
                       android:layout_marginEnd="15dp"
                       android:layout_below="@+id/webView_effort"
                       android:orientation="horizontal"
                       android:weightSum="4">
                       <TextView
                           android:id="@+id/txt_zone"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/zone"
                           android:fontFamily="@font/omnes_bold"
                           android:textColor="@color/AppBlackColor"/>

                       <TextView
                           android:id="@+id/txt_score"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/score"
                           android:fontFamily="@font/omnes_bold"
                           android:textColor="@color/AppBlackColor"/>

                       <TextView
                           android:id="@+id/txt_timezone"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/timeinzone"
                           android:fontFamily="@font/omnes_bold"
                           android:textColor="@color/AppBlackColor"/>

                       <TextView
                           android:id="@+id/txt_inzone"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/inzone"
                           android:fontFamily="@font/omnes_bold"
                           android:textColor="@color/AppBlackColor"/>
                   </LinearLayout>


                   <androidx.recyclerview.widget.RecyclerView
                       android:id="@+id/recycle_effort"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:nestedScrollingEnabled="false"
                       android:layout_marginTop= "2dp"
                       android:layout_marginStart="15dp"
                       android:layout_marginEnd="15dp"
                       android:layout_below="@+id/lay_effort_tit"/>

               </RelativeLayout>
               <RelativeLayout
                   android:id="@+id/relay_ranking"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="gone">

                   <LinearLayout
                       android:id="@+id/lay_ranking_tit"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop= "20dp"
                       android:layout_marginStart="5dp"
                       android:layout_marginEnd="5dp"
                       android:orientation="horizontal"
                       android:weightSum="3">
                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               android:id="@+id/txt_you"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:fontFamily="@font/omnes_semibold_regular"
                               android:text="@string/you"
                               android:textAlignment="center"
                               android:textColor="@color/AppMainColor"
                               android:textSize="16sp" />
                           <View
                               android:id="@+id/view_you"
                               android:layout_width="match_parent"
                               android:layout_height="2dp"
                               android:layout_marginTop="10dp"
                               android:background="@color/AppMainColor"/>

                       </LinearLayout>
                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               android:id="@+id/txt_friend"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:fontFamily="@font/omnes_semibold_regular"
                               android:text="@string/friend"
                               android:textAlignment="center"
                               android:textColor="@color/AppTextGrayColor"
                               android:textSize="16sp" />
                           <View
                               android:id="@+id/view_friend"
                               android:layout_width="match_parent"
                               android:layout_height="2dp"
                               android:layout_marginTop="10dp"
                               android:background="@color/AppWhiteColor"/>

                       </LinearLayout>
                       <LinearLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:orientation="vertical">

                           <TextView
                               android:id="@+id/txt_group"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:fontFamily="@font/omnes_semibold_regular"
                               android:text="@string/groupsmall"
                               android:textAlignment="center"
                               android:textColor="@color/AppTextGrayColor"
                               android:textSize="16sp" />
                           <View
                               android:id="@+id/view_group"
                               android:layout_width="match_parent"
                               android:layout_height="2dp"
                               android:layout_marginTop="10dp"
                               android:background="@color/AppWhiteColor"/>

                       </LinearLayout>
                   </LinearLayout>
                   <View
                       android:id="@+id/view_all"
                       android:layout_width="match_parent"
                       android:layout_height="1dp"
                       android:layout_below="@+id/lay_ranking_tit"
                       android:background="@color/AppLightGrayColor"/>

                   <LinearLayout
                       android:id="@+id/lay_alltimewalk"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop= "30dp"
                       android:layout_marginStart="1dp"
                       android:layout_marginEnd="1dp"
                       android:layout_below="@+id/view_all"
                       android:orientation="horizontal"
                       android:weightSum="2">

                       <TextView
                           android:id="@+id/txt_alltime"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:fontFamily="@font/omnes_semibold_regular"
                           android:text="@string/alltime"
                           android:textAlignment="center"
                           android:textColor="@color/AppTextGrayColor"
                           android:textSize="16sp" />

                       <TextView
                           android:id="@+id/txt_walk"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:fontFamily="@font/omnes_semibold_regular"
                           android:text="@string/walk"
                           android:textAlignment="center"
                           android:textColor="@color/AppTextGrayColor"
                           android:textSize="16sp" />

                   </LinearLayout>

                   <View
                       android:id="@+id/view_alltimewalk"
                       android:layout_width="match_parent"
                       android:layout_height="1dp"
                       android:layout_marginTop= "30dp"
                       android:layout_below="@+id/lay_alltimewalk"
                       android:background="@color/AppLightGrayColor"/>

                   <androidx.recyclerview.widget.RecyclerView
                       android:id="@+id/recycle_ranking"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:nestedScrollingEnabled="false"
                       android:layout_marginTop= "2dp"
                       android:layout_below="@+id/view_alltimewalk"/>

               </RelativeLayout>
           </RelativeLayout>

        </ScrollView>

    </RelativeLayout>
</layout>