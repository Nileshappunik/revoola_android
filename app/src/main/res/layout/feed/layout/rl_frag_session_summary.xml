<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <!--android:background="@drawable/full_round"-->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="16dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/winditdown"
            android:textAlignment="center"
            android:layout_marginTop="3dp"
            android:textAllCaps="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/AppBlackColor"/>

        <TextView
            android:id="@+id/iv_title_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="12/04/2023 at 08:46"
            android:textAlignment="center"
            android:layout_marginTop="1dp"
            android:textAllCaps="true"
            android:layout_below="@+id/iv_title"
            android:layout_centerHorizontal="true"
            android:textColor="@color/AppBlackColor" />

        <include
            android:id="@+id/inlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "5dp"
            android:layout_below="@+id/iv_title_date"
            layout="@layout/rl_frag_session_summary_title"/>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/inlay_title">
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent">
               <RelativeLayout
                   android:id="@+id/relay_summary"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="visible">

                   <androidx.viewpager.widget.ViewPager
                       android:id="@+id/viewPager_image"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:visibility="gone"
                       android:layout_marginTop="0dp" />

                   <ImageView
                       android:id="@+id/test_image"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:src="@drawable/walk"
                       android:scaleType="centerCrop"
                       android:layout_marginTop="0dp" />


                   <androidx.recyclerview.widget.RecyclerView
                       android:id="@+id/recycle_session"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:nestedScrollingEnabled="false"
                       android:layout_marginTop= "10dp"
                       android:layout_below="@+id/test_image"/>

               </RelativeLayout>
               <RelativeLayout
                   android:id="@+id/relay_analysis"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="gone">

                   <include
                       android:id="@+id/include_effort"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       layout="@layout/rl_feed_analysis_layout_map"/>


                   <include
                       android:id="@+id/include_elevation"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_effort"
                       layout="@layout/rl_feed_analysis_layout_map"/>

                   <include
                       android:id="@+id/include_speed"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_elevation"
                       layout="@layout/rl_feed_analysis_layout_map"/>

                   <include
                       android:id="@+id/include_pace"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="10dp"
                       android:layout_below="@+id/include_speed"
                       layout="@layout/rl_feed_analysis_layout_map"/>


               </RelativeLayout>
               <RelativeLayout
                   android:id="@+id/relay_effort"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:visibility="gone">

                   <include
                       android:id="@+id/inlay_chart"
                       layout="@layout/rl_layout_summary_effort"/>

                   <LinearLayout
                       android:id="@+id/lay_effort_tit"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop= "10dp"
                       android:layout_marginStart="15dp"
                       android:layout_marginEnd="15dp"
                       android:layout_below="@+id/inlay_chart"
                       android:orientation="horizontal"
                       android:weightSum="3.5">
                       <TextView
                           android:id="@+id/txt_zone"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="textStart"
                           android:text="@string/zone"
                           android:textColor="@color/AppBlackColor"/>

                       <TextView
                           android:id="@+id/txt_score"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/score"
                           android:textColor="@color/AppBlackColor"/>

                       <TextView
                           android:id="@+id/txt_timezone"
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1.5"
                           android:textSize="14sp"
                           android:textAlignment="center"
                           android:text="@string/timeinzone"
                           android:textColor="@color/AppBlackColor"/>

                   </LinearLayout>
                   <androidx.recyclerview.widget.RecyclerView
                       android:id="@+id/recycle_effort"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:nestedScrollingEnabled="false"
                       android:layout_marginTop= "13dp"
                       android:layout_marginStart="15dp"
                       android:layout_marginEnd="15dp"
                       android:layout_below="@+id/lay_effort_tit"/>

               </RelativeLayout>

           </RelativeLayout>

        </ScrollView>

    </RelativeLayout>
</layout>