<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">

        <RelativeLayout
            android:id="@+id/inlayTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="0dp"
                android:layout_centerVertical="true"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"/>

            <LinearLayout
                android:id="@+id/linear_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="10dp"
                android:layout_toEndOf="@+id/ivBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/iv_Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/omnes_regular"
                    android:layout_marginEnd="10dp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="14sp"/>


                <TextView
                    android:id="@+id/iv_Description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/omnes_regular"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="12sp"/>
            </LinearLayout>

        </RelativeLayout>


        <include
            android:id="@+id/inlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/inlayTop"
            layout="@layout/rl_frag_session_summary_title"/>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/inlay_title">
            <RelativeLayout
                android:id="@+id/relay_summary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:id="@+id/relative_session"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/constant_pager"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                tools:ignore="WebViewLayout">
                                <androidx.viewpager.widget.ViewPager
                                    android:id="@+id/viewPager_image"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="0dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintDimensionRatio="H,100:76"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

<!--                            <androidx.viewpager.widget.ViewPager-->
<!--                                android:id="@+id/viewPager_image"-->
<!--                                android:layout_width="match_parent"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:visibility="gone"-->
<!--                                android:layout_marginTop="0dp" />-->
                            <com.google.android.material.tabs.TabLayout
                                android:id="@+id/into_tab_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentRight="true"
                                android:visibility="gone"
                                android:layout_marginEnd="20dp"
                                app:tabBackground="@drawable/tab_pager_selector"
                                app:tabPaddingEnd="5dp"
                                app:tabPaddingStart="5dp"
                                app:tabGravity="center"
                                android:background="@null"
                                app:tabIndicatorHeight="0dp"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/test_image"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="0dp"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    android:src="@drawable/walk"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintDimensionRatio="H,100:7"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

<!--                            <ImageView-->
<!--                                android:id="@+id/test_image"-->
<!--                                android:layout_width="match_parent"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:src="@drawable/walk"-->
<!--                                android:visibility="gone"-->
<!--                                android:scaleType="centerCrop"-->
<!--                                android:layout_marginTop="0dp" />-->
                        </RelativeLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycle_session"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop= "10dp"
                            android:layout_below="@+id/relative_session"/>
                    </RelativeLayout>
                </ScrollView>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/relay_analysis"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/include_effort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            layout="@layout/rl_feed_analysis_layout_map"/>
                        <include
                            android:id="@+id/include_elevation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_below="@+id/include_effort"
                            layout="@layout/rl_feed_analysis_layout_map"/>
                        <include
                            android:id="@+id/include_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_below="@+id/include_elevation"
                            layout="@layout/rl_feed_analysis_layout_map"/>
                        <include
                            android:id="@+id/include_pace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_below="@+id/include_speed"
                            layout="@layout/rl_feed_analysis_pace_map"/>
                    </RelativeLayout>
                </ScrollView>
                <TextView
                    android:id="@+id/txt_withouthrmessage_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/withouthrmessage"
                    android:textColor="@color/AppBlackColor"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:textSize="18sp"
                    android:textAlignment="center"/>

            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/relay_effort"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <include
                            android:id="@+id/inlay_chart"
                            layout="@layout/rl_layout_summary_effort"/>
                        <LinearLayout
                            android:id="@+id/lay_effort_tit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop= "10dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp"
                            android:layout_below="@+id/inlay_chart"
                            android:orientation="horizontal"
                            android:weightSum="3.5">
                            <TextView
                                android:id="@+id/txt_zone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="14sp"
                                android:textAlignment="textStart"
                                android:text="@string/zone"
                                android:textColor="@color/AppBlackColor"/>

                            <TextView
                                android:id="@+id/txt_score"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="14sp"
                                android:textAlignment="center"
                                android:text="@string/score"
                                android:textColor="@color/AppBlackColor"/>

                            <TextView
                                android:id="@+id/txt_timezone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:textSize="14sp"
                                android:textAlignment="center"
                                android:text="@string/timeinzone"
                                android:textColor="@color/AppBlackColor"/>

                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycle_effort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop= "13dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp"
                            android:layout_below="@+id/lay_effort_tit"/>

                    </RelativeLayout>
                </ScrollView>
                <TextView
                    android:id="@+id/txt_withouthrmessage_effort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/withouthrmessage"
                    android:textColor="@color/AppBlackColor"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:textAlignment="center"
                    android:visibility="gone"
                    android:textSize="18sp" />

            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</layout>

