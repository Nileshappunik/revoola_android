<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

 <RelativeLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/AppWhiteColor">

     <LinearLayout
         android:id="@+id/inlayTop"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="15dp"
         android:layout_marginBottom="15dp"
         android:orientation="horizontal">
         <ImageView
             android:id="@+id/ivBack"
             android:layout_width="30dp"
             android:layout_height="30dp"
             android:layout_marginStart="10dp"
             app:tint="@color/AppMainColor"
             android:src="@drawable/ic_arrow_back_ios"/>

         <TextView
             android:id="@+id/iv_Title"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:fontFamily="@font/omnes_regular"
             android:singleLine="true"
             android:textStyle="bold"
             android:gravity="center"
             android:layout_gravity="center_vertical"
             android:layout_marginEnd="10dp"
             android:textColor="@color/AppBlackColor"
             android:textSize="18sp"/>

     </LinearLayout>

     <ImageView
         android:id="@+id/img_myride"
         android:layout_width="30dp"
         android:layout_height="30dp"
         android:padding="5dp"
         android:layout_marginStart="10dp"
         android:src="@drawable/ic_walk"
         android:background="@drawable/full_round"
         android:backgroundTint="@color/AppMainBGColor"
         android:layout_below="@+id/inlayTop"/>

     <TextView
         android:id="@+id/txt_myride"
         android:layout_width="wrap_content"
         android:layout_height="30dp"
         android:layout_marginStart="10dp"
         android:layout_below="@+id/inlayTop"
         android:layout_toEndOf="@+id/img_myride"
         android:gravity="center_vertical"
         android:singleLine="true"
         android:text="new challenge"
         android:fontFamily="@font/omnes_semibold_regular"
         android:textColor="@color/AppBlackColor"
         android:textSize="18sp"/>
     <ScrollView
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_below="@+id/img_myride">
         <RelativeLayout
             android:layout_width="match_parent"
             android:layout_height="match_parent">
             <LinearLayout
                 android:id="@+id/lay_all"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:weightSum="2.6"
                 android:background="@color/AppWhiteColor"
                 android:layout_marginStart="10dp">
                 <LinearLayout
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
                     android:background="@color/AppWhiteColor"
                     android:orientation="vertical">
                     <include
                         android:id="@+id/lay_stepssofar"
                         layout="@layout/rl_layout_common_challenge_summary" />

                     <include
                         android:id="@+id/lay_targetsteps"
                         layout="@layout/rl_layout_common_challenge_summary" />

                     <include
                         android:id="@+id/lay_daysremaining"
                         layout="@layout/rl_layout_common_challenge_summary" />

                     <include
                         android:id="@+id/lay_rank"
                         layout="@layout/rl_layout_common_challenge_summary" />
                 </LinearLayout>

                 <RelativeLayout
                     android:id="@+id/relay_chart"
                     android:layout_width="0dp"
                     android:layout_height="300dp"
                     android:layout_gravity="bottom"
                     android:layout_weight="1.6">
                     <WebView
                         android:id="@+id/webView_chart"
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"/>
                 </RelativeLayout>

             </LinearLayout>
             <WebView
                 android:id="@+id/webView_ranking_chart"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="10dp"
                 android:layout_below="@+id/lay_all"/>

             <TextView
                 android:id="@+id/txt_dailystep"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="20dp"
                 android:textAlignment="center"
                 android:layout_below="@+id/webView_ranking_chart"
                 android:text="DAILY STEPS"
                 android:fontFamily="@font/omnes_semibold_regular"
                 android:textColor="@color/AppBlackColor"
                 android:textSize="26sp"/>

             <WebView
                 android:id="@+id/webView_step_chart"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="10dp"
                 android:layout_below="@+id/txt_dailystep"/>
         </RelativeLayout>
     </ScrollView>
 </RelativeLayout>

</layout>