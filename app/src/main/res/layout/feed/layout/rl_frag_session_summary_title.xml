<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/AppWhiteColor"
        android:weightSum="3"
        android:orientation="horizontal">
        <RelativeLayout
            android:id="@+id/layout_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:id="@+id/txt_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUMMARY"
                android:fontFamily="@font/omnes_regular"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textColor="@color/AppMainColor"/>
            <View
                android:id="@+id/view_summary"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/txt_summary"
                android:background="@color/AppMainColor"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_analysis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:id="@+id/txt_analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANALYSIS"
                android:fontFamily="@font/omnes_regular"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textColor="@color/AppBlackColor"/>
            <View
                android:id="@+id/view_analysis"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/txt_analysis"
                android:background="@color/AppWhiteColor"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_effort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:id="@+id/txt_effoert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EFFORT"
                android:fontFamily="@font/omnes_regular"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textColor="@color/AppBlackColor"/>
            <View
                android:id="@+id/view_effort"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/txt_effoert"
                android:background="@color/AppWhiteColor"/>
        </RelativeLayout>
    </LinearLayout>
</layout>