<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/feedsmall"
                android:textColor="@color/AppBlackColor"
                android:textSize="36sp"
                android:layout_toStartOf="@+id/img_plus"
                android:fontFamily="@font/omnes_semibold_regular" />

            <ImageView
                android:id="@+id/img_plus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/ic_plus"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycle_session_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop= "15dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_below="@+id/txt_name"/>
        </RelativeLayout>

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
            android:visibility="gone"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <RelativeLayout
            android:id="@+id/lay_friends"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/txt_friends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/friendssmall"
                android:textColor="@color/AppMainColor"
                android:textSize="15sp"
                android:fontFamily="@font/omnes_semibold_regular" />
            <View
                android:id="@+id/view_friends"
                android:layout_width="50dp"
                android:layout_height="3dp"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/txt_friends"
                android:background="@color/AppMainColor"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/lay_groups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/txt_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/groupsmall"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="15sp"
                android:fontFamily="@font/omnes_semibold_regular" />
            <View
                android:id="@+id/view_groups"
                android:layout_width="50dp"
                android:layout_height="3dp"
                android:visibility="gone"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/txt_groups"
                android:background="@color/AppMainColor"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/lay_you"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/txt_you"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yousmall"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="15sp"
                android:fontFamily="@font/omnes_semibold_regular" />
            <View
                android:id="@+id/view_you"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                android:layout_below="@+id/txt_you"
                android:background="@color/AppMainColor"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/lay_challenges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/txt_challenges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/challengessmall"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="15sp"
                android:fontFamily="@font/omnes_semibold_regular" />
            <View
                android:id="@+id/view_challenges"
                android:layout_width="80dp"
                android:layout_height="3dp"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                android:layout_below="@+id/txt_challenges"
                android:background="@color/AppMainColor"/>
        </RelativeLayout>



    </LinearLayout>

        <RelativeLayout
            android:id="@+id/relay_groupname"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/img_user"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:padding="10dp"
                android:background="@drawable/full_round"
                android:backgroundTint="@color/AppMainColor"
                android:src="@drawable/ic_walk"
                app:tint="@color/AppWhiteColor"/>

            <TextView
                android:id="@+id/txt_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/img_user"
                android:text="123"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="@dimen/text_title_size"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relay_listview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_itemfeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

    </LinearLayout>
</layout>