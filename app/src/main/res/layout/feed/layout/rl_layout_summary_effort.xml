<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/lay_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2.6"
        android:background="@color/AppMainBGColor"
        android:paddingStart="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <include
                android:id="@+id/lay_effort_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/rl_common_summary_effort" />

            <include
                android:id="@+id/lay_effort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                layout="@layout/rl_common_summary_effort" />

            <include
                android:id="@+id/lay_effort_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                layout="@layout/rl_common_summary_effort" />

            <include
                android:id="@+id/lay_max_effort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                layout="@layout/rl_common_summary_effort" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relay_chart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/AppMainBGColor"
            android:layout_weight="1.6">

            <WebView
                android:id="@+id/webView_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"/>

        </RelativeLayout>

    </LinearLayout>

</layout>