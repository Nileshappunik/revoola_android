<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_Chalengis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/AppWhiteColor"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        android:layout_margin="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="1dp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_user"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/classes"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txt_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                app:layout_constraintLeft_toRightOf="@+id/img_user"
                android:text="@string/hidhruv"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txt_userdatetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="15dp"
                app:layout_constraintLeft_toRightOf="@+id/img_user"
                app:layout_constraintTop_toBottomOf="@+id/txt_username"
                android:text="13/5/2024"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="12sp"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_organizer_user"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="15dp"
                android:src="@drawable/wellcome"
                app:tint="@color/AppBottomGrayColor"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/txt_organizer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toStartOf="@+id/img_organizer_user"
                app:layout_constraintTop_toTopOf="parent"
                android:text="Paul Goossens"
                android:textStyle="bold"
                android:fontFamily="@font/omnes_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txt_organizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toStartOf="@+id/img_organizer_user"
                app:layout_constraintTop_toBottomOf="@+id/txt_organizer_name"
                android:text="ORGANISER"
                android:fontFamily="@font/omnes_regular"
                android:textStyle="bold"
                android:textColor="@color/AppBlackColor"
                android:textSize="12sp"/>

            <ImageView
                android:id="@+id/img_myride"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_walk"
                android:background="@drawable/full_round"
                android:backgroundTint="@color/AppMainBGColor"
                app:layout_constraintTop_toBottomOf="@+id/img_user"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txt_myride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/img_user"
                app:layout_constraintLeft_toRightOf="@+id/img_myride"
                android:text="new challenge"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="18sp"/>

            <LinearLayout
                android:id="@+id/lay_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2.3"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@+id/img_myride"
                app:layout_constraintStart_toStartOf="parent">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <include
                        android:id="@+id/lay_stepssofar"
                        layout="@layout/rl_common_image_title_subtitle" />

                    <include
                        android:id="@+id/lay_targetsteps"
                        layout="@layout/rl_common_image_title_subtitle" />

                    <include
                        android:id="@+id/lay_daysremaining"
                        layout="@layout/rl_common_image_title_subtitle" />
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/relay_chart"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1.3">

                    <WebView
                        android:id="@+id/webView_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </RelativeLayout>

            </LinearLayout>
            <RelativeLayout
                android:id="@+id/lay_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/AppMainBGColor"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:paddingStart="10dp"
                android:paddingEnd="40dp"
                app:layout_constraintTop_toBottomOf="@+id/lay_all"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/img_share"
                    android:layout_width="@dimen/feedcardbottomiconwidth"
                    android:layout_height="@dimen/feedcardbottomiconheight"
                    android:src="@drawable/ic_share"
                    android:layout_alignParentRight="true"/>

            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedbottomlineheight"
                app:layout_constraintTop_toBottomOf="@+id/lay_bottom"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@color/AppLightGrayColor"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>