<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <!--android:background="@drawable/full_round"-->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_title"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:textSize="18sp"
            android:text="@string/sessionsummerys"
            android:gravity="center"

            android:layout_marginTop="10dp"
            android:layout_centerHorizontal="true"
            android:textColor="@color/AppBlackColor"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/iv_title">
            <RelativeLayout
                android:id="@+id/relay_summary"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/test_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/walk"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop= "2dp"
                    android:layout_below="@+id/test_image"/>

            </RelativeLayout>

        </ScrollView>

    </RelativeLayout>
</layout>