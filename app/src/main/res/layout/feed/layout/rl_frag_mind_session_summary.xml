<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">

        <include
            android:id="@+id/inlayTop"
            layout="@layout/rl_layout_common_start_top"/>

        <!--android:background="@drawable/full_round"-->


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/inlayTop">
            <RelativeLayout
                android:id="@+id/relay_summary"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/test_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/walk"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop= "2dp"
                    android:layout_below="@+id/test_image"/>

            </RelativeLayout>

        </ScrollView>

    </RelativeLayout>
</layout>