<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_Chalengis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/AppWhiteColor"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        android:layout_margin="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="1dp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_user"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/classes"/>

            <TextView
                android:id="@+id/txt_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@+id/img_user"
                android:layout_toStartOf="@+id/img_threedot"
                android:text="@string/hidhruv"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txt_userdatetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@+id/img_user"
                android:layout_toStartOf="@+id/img_threedot"
                android:layout_below="@+id/txt_username"
                android:text="23/04/2024 16:57"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="12sp"/>

            <ImageView
                android:id="@+id/img_threedot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fd_options_gray"
                android:layout_marginEnd="15dp"
                android:layout_alignParentRight="true"
                app:tint="@color/AppBottomGrayColor"
                android:layout_below="@+id/txt_username"/>

            <TextView
                android:id="@+id/temptext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="15dp"
                android:layout_below="@+id/img_user"
                android:visibility="gone"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="12sp"/>

            <ImageView
                android:id="@+id/img_myride"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="10dp"
                android:padding="5dp"
                android:backgroundTint="@color/AppMainBGColor"
                android:background="@drawable/full_round"
                android:src="@drawable/fd_ride_green"
                android:layout_below="@+id/temptext" />

            <TextView
                android:id="@+id/txt_myride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="15dp"
                android:layout_below="@+id/temptext"
                android:layout_toEndOf="@+id/img_myride"
                android:text="@string/myride"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="18sp"/>

            <LinearLayout
                android:id="@+id/lay_all_common"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="3dp"
                android:layout_marginTop="10dp"
                android:weightSum="2.3"
                android:layout_below="@+id/img_myride">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                <include
                    android:id="@+id/lay_time"
                    layout="@layout/rl_common_image_title_subtitle" />
                <include
                    android:id="@+id/lay_calories"
                    layout="@layout/rl_common_image_title_subtitle" />
                <include
                    android:id="@+id/lay_assumedeffort"
                    layout="@layout/rl_common_image_title_subtitle" />
                <include
                    android:id="@+id/lay_steps"
                    layout="@layout/rl_common_image_title_subtitle" />
                </LinearLayout>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_nain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:scaleType="fitXY"
                    android:layout_gravity="bottom"
                    app:shapeAppearanceOverlay="@style/CornerCut"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/lay_bottom"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="@color/AppMainBGColor"
                android:gravity="center_vertical"
                android:weightSum="4"
                android:layout_below="@+id/lay_all_common">

                <View
                    android:id="@+id/blanck_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_weight="2"/>

                <View
                    android:id="@+id/blanck_view1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_weight="3"/>

                <RelativeLayout
                    android:id="@+id/layout_thumb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/img_thum"
                        android:layout_width="@dimen/feedcardbottomiconwidth"
                        android:layout_height="@dimen/feedcardbottomiconheight"
                        android:src="@drawable/ic_thumbs_g"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/txt_thum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:visibility="visible"
                        android:layout_centerVertical="true"
                        android:textColor="@color/AppBlackColor"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/img_thum"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layout_award"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/img_award"
                        android:layout_width="@dimen/feedcardbottomiconwidth"
                        android:layout_height="@dimen/feedcardbottomiconheight"
                        android:src="@drawable/ic_award_g"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/txt_award"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:visibility="visible"
                        android:layout_centerVertical="true"
                        android:textColor="@color/AppBlackColor"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/img_award"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layout_comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/img_comment"
                        android:layout_width="@dimen/feedcardbottomiconwidth"
                        android:layout_height="@dimen/feedcardbottomiconheight"
                        android:src="@drawable/fd_comment_gray"
                        android:layout_centerVertical="true"
                        app:tint="@color/AppBottomGrayColor"/>

                    <TextView
                        android:id="@+id/txt_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:visibility="visible"
                        android:layout_centerVertical="true"
                        android:textColor="@color/AppBlackColor"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/img_comment"/>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layout_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/img_share"
                        android:layout_width="@dimen/feedcardbottomiconwidth"
                        android:layout_height="@dimen/feedcardbottomiconheight"
                        android:src="@drawable/ic_share"
                        android:layout_centerInParent="true"/>

                </RelativeLayout>

            </LinearLayout>

            <View
                android:id="@+id/view_bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedbottomlineheight"
                android:layout_below="@+id/lay_bottom"
                android:background="@color/AppLightGrayColor"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</layout>


