                            android:id="@+id/img_comment"
                            android:layout_width="@dimen/feedcardbottomiconwidth"
                            android:layout_height="@dimen/feedcardbottomiconheight"
                            android:src="@drawable/fd_comment_gray"
                            android:layout_centerVertical="true"
                            app:tint="@color/AppBottomGrayColor"/>

                        <TextView
                            android:id="@+id/txt_comment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:visibility="visible"
                            android:layout_centerVertical="true"
                            android:textColor="@color/AppBlackColor"
                            android:fontFamily="@font/omnes_semibold_regular"
                            android:layout_marginStart="5dp"
                            android:layout_toEndOf="@+id/img_comment"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/layout_share"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/img_share"
                            android:layout_width="@dimen/feedcardbottomiconwidth"
                            android:layout_height="@dimen/feedcardbottomiconheight"
                            android:src="@drawable/ic_share"
                            android:layout_centerInParent="true"/>

                    </RelativeLayout>

                </LinearLayout>-->

                <View
                    android:id="@+id/view_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/feedbottomlineheight"
                    android:layout_below="@+id/lay_all_common"
                    android:background="@color/AppLightGrayColor"/>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/bigChallengesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@color/AppjoinChallengeColor"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bigChallengesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aptos_bold"
                    android:textAlignment="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="22sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">
                    <TextView
                        android:id="@+id/bigChallengesDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/aptos_regular"
                        android:textAlignment="textStart"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="22sp"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_Main_bigChallenges"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="2dp"
                        app:shapeAppearanceOverlay="@style/CornerCut" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ButtonJoinChallenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/round_border_login_green"
                    android:textAllCaps="true"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:text="@string/joinchallenge"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="18sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/feedbottomlineheight"
                    android:background="@color/AppLightGrayColor"/>

            </LinearLayout>
        </RelativeLayout>



    </androidx.cardview.widget.CardView>

</layout>


