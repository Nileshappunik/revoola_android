<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_friend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/CornerRound"
            android:src="@drawable/sample_user"/>

        <TextView
            android:id="@+id/txt_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/img_friend"
            android:text="dhruv90"
            android:fontFamily="@font/omnes_regular"
            android:textColor="@color/AppBlackColor"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txt_friend_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/txt_friend_name"
            android:layout_toStartOf="@+id/txt_friend_number"
            android:textAlignment="center"
            android:fontFamily="@font/omnes_regular"
            android:text="07/04/2023"
            android:textSize="16sp"
            android:textColor="@color/AppTextGrayColor"/>

        <TextView
            android:id="@+id/txt_friend_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:fontFamily="@font/omnes_regular"
            android:text="3229"
            android:textSize="16sp"
            android:textColor="@color/AppBlackColor"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppLightGrayColor"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</layout>
