<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/relative_comment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="@color/AppLightGrayColor">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"/>

            <TextView
                android:id="@+id/iv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:text="COMMENTS"
                android:textAlignment="textStart"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:layout_below="@+id/ivBack"/>

            <include
                android:id="@+id/inlay_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_title"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp"
                layout="@layout/rl_layout_feed_list"/>
            <View
                android:id="@+id/view_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/inlay_main"
                android:background="@color/AppLightGrayColor"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_commentList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/view_2"
                android:layout_above="@+id/txt_addcomment"
                android:background="@color/AppWhiteColor"
                tools:listitem="@layout/rl_layout_comment_user"/>

            <TextView
                android:id="@+id/txt_addcomment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:text="@string/addcomment"
                android:layout_above="@+id/ed_comment"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textSize="14sp"
                android:textColor="@color/AppTextGrayColor"/>

            <EditText
                android:id="@+id/ed_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="5dp"
                android:paddingStart="20dp"
                android:gravity="center_vertical"
                android:hint="Comments"
                android:background="@drawable/rounded_corners"
                android:layout_above="@+id/btn_send"
                android:textColor="@color/AppBlackColor"
                android:textColorHint="@color/AppTextGrayColor"
                android:textSize="@dimen/text_main_title_size"
                android:fontFamily="@font/omnes_semibold_regular" />


            <TextView
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/send"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:gravity="center"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textSize="16sp"
                android:textColor="@color/AppWhiteColor"
                android:backgroundTint="@color/AppMainColor"
                android:background="@drawable/full_round"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/relative_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/AppWhiteColor">

            <ImageView
                android:id="@+id/ivBack_thumb"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:text="BOOSTS"
                android:textAlignment="textStart"
                android:layout_marginTop="30dp"
                android:layout_marginStart="22dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"
                android:layout_below="@+id/ivBack_thumb"/>

            <include
                android:id="@+id/inlay_main_thumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="10dp"
                layout="@layout/rl_layout_feed_list"/>

        </LinearLayout>
    </RelativeLayout>

</layout>