<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_common" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/off_white" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/img_session"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/wellcome"/>
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_user_session"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_below="@+id/img_session"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/wellcome"/>

                <TextView
                    android:id="@+id/txt_session_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25sp"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/img_user_session"
                    android:layout_toStartOf="@+id/txt_session_date"
                    android:layout_below="@+id/img_session"
                    android:text="Goose"
                    android:textSize="16sp"
                    android:textColor="@color/Gray"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txt_session_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25sp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_alignParentRight="true"
                    android:layout_below="@+id/img_session"
                    android:text="Fri,10 May | 5:42"
                    android:textSize="14sp"
                    android:textColor="@color/Gray"
                    android:textStyle="normal"/>

                <TextView
                    android:id="@+id/txt_session_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25sp"
                    android:layout_marginStart="10dp"
                    android:layout_below="@+id/img_user_session"
                    android:text="Living Life Joyfully"
                    android:textSize="22sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txt_session_description_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15sp"
                    android:layout_marginStart="10dp"
                    android:layout_below="@+id/txt_session_title"
                    android:text="Description"
                    android:textSize="16sp"
                    android:textColor="@color/Gray"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txt_session_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15sp"
                    android:layout_marginStart="10dp"
                    android:layout_below="@+id/txt_session_description_title"
                    android:text="Use this short mediation to establish your priorities and live your life full of joy and love today every day."
                    android:textSize="14sp"
                    android:textColor="@color/darkGray"
                    android:textStyle="normal"/>

                <include
                    android:id="@+id/relay_mindfull_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    layout="@layout/common_session_summary_card"
                    android:layout_below="@+id/txt_session_description" />

                <include
                    android:id="@+id/relay_assumed_relaxation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    layout="@layout/common_session_summary_card"
                    android:layout_below="@+id/relay_mindfull_minutes" />

                <include
                    android:id="@+id/relay_boosts"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    layout="@layout/common_session_summary_lay"
                    android:layout_below="@+id/relay_assumed_relaxation" />

                <include
                    android:id="@+id/relay_comments"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    layout="@layout/common_session_summary_lay"
                    android:layout_below="@+id/relay_boosts" />

                <include
                    android:id="@+id/relay_awards"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    layout="@layout/common_session_summary_lay"
                    android:layout_below="@+id/relay_comments" />



            </RelativeLayout>

        </ScrollView>

    </LinearLayout>
</layout>