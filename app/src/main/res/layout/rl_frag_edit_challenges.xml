<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/inlayTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:layout_centerVertical="true"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"/>

            <TextView
                android:id="@+id/iv_Title"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_toStartOf="@+id/ivhelp"
                android:layout_toEndOf="@+id/ivBack"
                android:fontFamily="@font/omnes_semibold_regular"
                android:layout_marginEnd="10dp"
                android:textAllCaps="true"
                android:layout_centerVertical="true"
                android:textAlignment="center"
                android:text="@string/challenge_summary"
                android:textColor="@color/AppBlackColor"
                android:textSize="24sp"/>

            <ImageView
                android:id="@+id/ivhelp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_info"/>
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btn_Invite_Contacts"
            android:layout_below="@+id/inlayTop"/>

        <Button
            android:id="@+id/btn_Invite_Contacts"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:textColor="@color/AppWhiteColor"
            android:backgroundTint="@color/AppZone4Color"
            android:text="@string/invite_contacts"
            android:layout_above="@+id/btn_Done"
            android:background="@drawable/round_border_black"/>

        <Button
            android:id="@+id/btn_Done"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:textColor="@color/AppWhiteColor"
            android:backgroundTint="@color/AppMainColor"
            android:text="@string/done"
            android:background="@drawable/round_border_black"/>

    </RelativeLayout>
</layout>
