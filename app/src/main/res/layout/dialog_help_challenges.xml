<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/square_border"
            android:padding="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="43dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:text="@string/youcandunumber"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="15dp"
                android:text="@string/revoolasync"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="15dp"
                android:textStyle="bold"
                android:text="@string/revoolachallengesinclude"
                android:textColor="@color/black"/>


            <include
                android:id="@+id/lay_step"
                layout="@layout/common_layout_help_dialog"/>

            <include
                android:id="@+id/lay_effort"
                layout="@layout/common_layout_help_dialog"/>

            <include
                android:id="@+id/lay_calories"
                layout="@layout/common_layout_help_dialog"/>

            <include
                android:id="@+id/lay_distance"
                layout="@layout/common_layout_help_dialog"/>

            <include
                android:id="@+id/lay_climbed"
                layout="@layout/common_layout_help_dialog"/>

            <include
                android:id="@+id/lay_duration"
                layout="@layout/common_layout_help_dialog"/>

            <!--   <View
                   android:layout_width="match_parent"
                   android:layout_height="10dp"
                   android:background="@color/white"/>-->

        </LinearLayout>
    </RelativeLayout>


</layout>
