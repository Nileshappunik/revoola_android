<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_mind"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginStart="15dp"
            android:scaleType="fitXY"
            app:shapeAppearanceOverlay="@style/CornerCut"
            android:src="@drawable/ride"/>

        <ImageView
            android:id="@+id/img_right"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_user"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/img_mind"
            android:src="@drawable/run"/>

        <TextView
            android:id="@+id/txt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/img_user"
            android:layout_toStartOf="@+id/img_right"
            android:textColor="@color/Gray"
            android:text="sam Rehan"/>

        <TextView
            android:id="@+id/txt_classname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/img_mind"
            android:layout_toStartOf="@+id/img_right"
            android:layout_below="@+id/txt_username"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:text="Introducing Laughter Yoga"/>

        <TextView
            android:id="@+id/txt_classtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/img_mind"
            android:layout_below="@+id/txt_classname"
            android:textColor="@color/Gray"
            android:text="17mins"/>

        <View
            android:id="@+id/viewdivider"
            android:layout_width="1dp"
            android:layout_height="15dp"
            android:background="@color/Gray"
            android:layout_marginTop="10dp"
            android:layout_toEndOf="@+id/txt_classtime"
            android:layout_below="@+id/txt_classname"/>

        <TextView
            android:id="@+id/txt_videoaudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_toStartOf="@+id/img_right"
            android:layout_toEndOf="@+id/viewdivider"
            android:layout_below="@+id/txt_classname"
            android:textColor="@color/Gray"
            android:text="Video"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/txt_videoaudio"/>

    </RelativeLayout>
</layout>