<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/AppWhiteColor">
        <include
            android:id="@+id/inlayTop"
            layout="@layout/rl_layout_common_start_top"/>

        <LinearLayout
            android:id="@+id/layIndividualTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/square_border_green_ten"
            android:orientation="vertical">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_goal"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textSize="16sp"
                android:textAlignment="center"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/individualtarget"
                android:textStyle="bold"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/laySharedTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/square_border_green_ten"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/goal_shared"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textSize="16sp"
                android:textAlignment="center"
                android:gravity="center"
                android:singleLine="true"
                android:textAllCaps="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/sharedtarget"
                android:textStyle="bold"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textColor="@color/AppBlackColor"/>
        </LinearLayout>

    </LinearLayout>
</layout>
