<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">
       <include
           android:id="@+id/inlayTop"
           layout="@layout/rl_layout_common_start_top"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/all_menu_start_margin"
            android:layout_marginEnd="@dimen/all_menu_end_margin"
            android:layout_marginBottom="@dimen/all_menu_bottom_margin"
            android:orientation="vertical"
            android:visibility="gone"
            android:weightSum="4">
            <include
                android:id="@+id/inlay_walk"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_run"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/all_menu_top_margin"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_ride"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/all_menu_top_margin"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_workout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/all_menu_top_margin"
                layout="@layout/rl_layout_start_menu"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvYourway"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </RelativeLayout>
    </LinearLayout>
</layout>