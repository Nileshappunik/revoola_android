<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_start"
        android:layout_width="match_parent"
        android:background="@color/AppLightGrayColor"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/wellcome"
            app:shapeAppearanceOverlay="@style/CornerCut" />


        <TextView
            android:id="@+id/txt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classes"
            android:visibility="visible"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="20dp"
            android:textColor="@color/AppWhiteColor"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/omnes_semibold_regular"/>

        <TextView
            android:id="@+id/txt_class_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classes"
            android:visibility="gone"
            android:layout_marginBottom="30dp"
            android:layout_marginLeft="25dp"
            android:textColor="@color/AppWhiteColor"
            android:textSize="22sp"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/omnes_semibold_regular"/>

        <TextView
            android:id="@+id/txt_yourway_name"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:text="Workout"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="20dp"
            android:visibility="gone"
            android:textColor="@color/AppTextGrayColor"
            android:gravity="center"
            android:background="@drawable/round_border_white"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/omnes_semibold_regular"/>

        <ImageView
            android:id="@+id/img_class"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:padding="10dp"
            android:background="@drawable/full_round"
            android:src="@drawable/ic_mind_read"/>

    </RelativeLayout>
</layout>