<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/relay_start"
        android:layout_width="wrap_content"
        android:layout_height="220dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/AppWhiteColor">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/wellcome"
            app:shapeAppearanceOverlay="@style/CornerCutfive" />
        <TextView
            android:id="@+id/txt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="20dp"
            android:layout_marginBottom="20dp"
            android:textSize="18sp"
            android:fontFamily="@font/omnes_regular"
            android:text="Classes"
            android:textColor="@color/AppWhiteColor"
            android:visibility="visible" />

        <TextView
            android:id="@+id/txt_class_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="25dp"
            android:layout_marginBottom="30dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:text="Classes"
            android:textColor="@color/AppWhiteColor"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_yourway_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/round_border_white"
            android:fontFamily="@font/omnes_regular"
            android:gravity="center"
            android:text="Workout"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:textColor="@color/AppTextGrayColor"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_class"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/full_round"
            android:padding="10dp"
            android:src="@drawable/ic_mind_read"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_last"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="36sp"
            android:gravity="center_vertical"
            android:fontFamily="@font/omnes_regular"
            android:text="@string/thebestyoueveryday"
            android:textColor="@color/AppBlackColor"
            android:visibility="gone" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relay_start_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="10dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_type"
            android:layout_width="150dp"
            android:layout_height="160dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/ride"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CornerCut"/>

        <ImageView
            android:id="@+id/img_right"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/img_typeicon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="@drawable/ic_speeed"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/img_type"/>

        <TextView
            android:id="@+id/txt_typename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/mindclasses"
            android:layout_toEndOf="@+id/img_typeicon"
            android:layout_toStartOf="@+id/img_right"
            android:textColor="@color/AppBlackColor"/>

        <TextView
            android:id="@+id/txt_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/img_type"
            android:layout_toStartOf="@+id/img_right"
            android:layout_below="@+id/txt_typename"
            android:textColor="@color/AppBlackColor"
            android:fontFamily="@font/omnes_semibold_regular"/>


    </RelativeLayout>
</LinearLayout>

</layout>