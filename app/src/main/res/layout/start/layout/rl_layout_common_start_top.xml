<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            app:tint="@color/AppDarkGrayColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <ImageView
            android:id="@+id/ivhelp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="15dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_info"/>



        <LinearLayout
            android:id="@+id/linear_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/smallLogo"
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:visibility="gone"
                android:layout_gravity="center"
                android:src="@drawable/ic_revoola_logo"/>
            <TextView
                android:id="@+id/iv_Title"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:layout_marginEnd="10dp"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:text="@string/yourway"
                android:textColor="@color/AppBlackColor"
                android:textSize="26sp"/>
            <TextView
                android:id="@+id/iv_Description"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="@font/omnes_regular"
                android:layout_marginEnd="10dp"
                android:textAllCaps="true"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/youractivityyourway"
                android:textColor="@color/AppBlackColor"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>




        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_title">
            <ImageView
                android:id="@+id/logo"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:visibility="gone"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_revoola_logo"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTitle"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:foregroundGravity="bottom"
                android:layout_marginStart="6dp"
                android:layout_below="@+id/logo"/>
        </RelativeLayout>




    </RelativeLayout>
</layout>