<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:tint="@color/AppDarkGrayColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <ImageView
            android:id="@+id/ivhelp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_info"/>

        <TextView
            android:id="@+id/iv_Title"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginEnd="10dp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:text="@string/yourway"
            android:textColor="@color/AppBlackColor"
            android:textSize="26sp"/>

        <TextView
            android:id="@+id/iv_Description"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:fontFamily="@font/omnes_regular"
            android:layout_marginEnd="10dp"
            android:layout_below="@+id/iv_Title"
            android:textAllCaps="true"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/youractivityyourway"
            android:textColor="@color/AppBlackColor"
            android:textSize="14sp"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTitle"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:foregroundGravity="bottom"
            android:layout_marginStart="6dp"
            android:layout_below="@+id/iv_Description"/>

    </RelativeLayout>
</layout>