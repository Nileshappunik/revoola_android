<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_arrow_back_ios"/>

        <TextView
            android:id="@+id/iv_Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/ivBack"
            android:layout_toStartOf="@+id/ivhelp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:text="@string/yourway"
            android:textColor="@color/AppBlackColor"
            android:textSize="32sp"/>

        <TextView
            android:id="@+id/iv_Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginEnd="10dp"
            android:layout_below="@+id/iv_Title"
            android:layout_toEndOf="@+id/ivBack"
            android:layout_toStartOf="@+id/ivhelp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:text="@string/youractivityyourway"
            android:textColor="@color/AppBlackColor"
            android:textSize="18sp"/>

        <ImageView
            android:id="@+id/ivhelp"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="5dp"
            android:src="@drawable/info"/>

    </RelativeLayout>
</layout>