<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_videoplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppBlackColor">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"/>

    <RelativeLayout
        android:id="@+id/leftsideview"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="100dp"
        android:background="@null">
        <RelativeLayout
            android:id="@+id/linear_heart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null">

            <RelativeLayout
                android:id="@+id/rl_heartrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/inlay_effort">

                <com.example.myfirstapp.ui.RLCircularProgressBar
                    android:id="@+id/circularProgressBar"
                    android:layout_marginStart="20dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:text="77%"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="50dp"
                    android:textAlignment="center"
                    android:textColor="@color/AppWhiteColor"
                    android:textStyle="bold"
                    android:fontFamily="@font/omnes_regular"/>

            </RelativeLayout>

            <include
                android:id="@+id/inlay_effort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/inlay_calories"
                layout="@layout/rl_common_start_class_with_sensor"/>
            <include
                android:id="@+id/inlay_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/inlay_heartrate"
                layout="@layout/rl_common_start_class_with_sensor"/>
            <include
                android:id="@+id/inlay_heartrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/inlay_cadence"
                layout="@layout/rl_common_start_class_with_sensor"/>
            <include
                android:id="@+id/inlay_cadence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/inlay_time"
                layout="@layout/rl_common_start_class_with_sensor"/>

            <include
                android:id="@+id/inlay_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp"
                layout="@layout/rl_common_start_class_with_sensor"/>
        </RelativeLayout>
    </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rightsideviewclick"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="50dp"
            android:minWidth="150dp"
            android:layout_alignParentRight="true"
            android:background="@null">
            <include
                android:id="@+id/recycler_list_itemview"
                android:layout_width="150dp"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content"
                layout="@layout/rl_layout_heartrate_sensor_user"/>
        <RelativeLayout
            android:id="@+id/rightsideview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:background="@null"/>
        </RelativeLayout>

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/lay_play_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="visible"
            android:orientation="horizontal"
            android:gravity="center">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_pause_resume"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_pause_button"/>
                <TextView
                    android:id="@+id/txt_pause_resume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="18sp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="PAUSE"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_stop"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_stop_button"/>
                <TextView
                    android:id="@+id/txt_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="18sp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="STOP"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/relay_countdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="@color/AppBlackColor">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <TextView
                    android:id="@+id/txt_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:visibility="visible"
                    android:fontFamily="@font/omnes_regular"
                    android:textSize="55sp"
                    android:text="5"
                    android:textColor="@color/AppWhiteColor"/>
                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:textSize="36sp"
                    android:text="Set Personal Targets"
                    android:layout_below="@+id/txt_countdown"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppWhiteColor"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:id="@+id/lay_width"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/txt_title"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:id="@+id/txt_with"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="3dp"
                        android:textSize="18sp"
                        android:text="@string/with"
                        android:fontFamily="@font/omnes_regular"
                        android:textColor="@color/AppWhiteColor"
                        android:textAlignment="center"/>
                    <TextView
                        android:id="@+id/txt_namewith"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="18sp"
                        android:text="John MArtimore"
                        android:layout_below="@+id/txt_title"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:textColor="@color/AppWhiteColor"
                        android:textAlignment="center"/>
                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/rl_body_timenumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lay_width">
                    <LinearLayout
                        android:id="@+id/lay_timevideo"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:layout_weight="1">
                            <ImageView
                                android:id="@+id/img_minutes"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_centerVertical="true"
                                app:tint="@color/AppDarkGrayColor"
                                android:src="@drawable/fd_active_time_green"/>
                            <TextView
                                android:id="@+id/txt_minutes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:text="20 mins"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@+id/img_minutes"
                                android:fontFamily="@font/omnes_regular"
                                android:textColor="@color/AppWhiteColor"
                                android:gravity="start"/>

                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:layout_weight="1">
                            <ImageView
                                android:id="@+id/img_video"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/txt_video"
                                android:src="@drawable/ic_easy"/>
                            <TextView
                                android:id="@+id/txt_video"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:text="Beginner"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/omnes_regular"
                                android:textColor="@color/AppMainColor"
                                android:gravity="start"/>
                        </RelativeLayout>
                    </LinearLayout>

                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

</layout>
