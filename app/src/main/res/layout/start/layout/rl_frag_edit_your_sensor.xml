<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppLightGrayColor"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:background="@drawable/full_round"
            android:src="@drawable/ic_back_g"/>

        <TextView
            android:id="@+id/tvtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/edityoursensor"
            android:textColor="@color/AppBlackColor"
            android:textSize="36dp"
            android:fontFamily="@font/omnes_semibold_regular" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
           <androidx.cardview.widget.CardView
               android:id="@+id/card_sensor_name"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginStart="10dp"
               android:layout_marginEnd="10dp"
               android:layout_marginTop="25dp"
               app:cardCornerRadius="10dp">

               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginStart="15dp"
                   android:layout_marginEnd="15dp"
                   android:layout_marginBottom="40dp">

                   <TextView
                       android:id="@+id/txtspeeddistance"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="15dp"
                       android:text="@string/nameyoursensorcaps"
                       android:textColor="@color/AppTextGrayColor"
                       android:textSize="16sp"
                       android:fontFamily="@font/omnes_regular" />


                   <EditText
                       android:id="@+id/edt_sensor_name"
                       android:layout_width="match_parent"
                       android:layout_height="50dp"
                       android:paddingStart="15dp"
                       android:layout_marginTop="15dp"
                       android:text="TICKRX80c4"
                       android:background="@drawable/square_border_dark_fill_light"
                       android:layout_below="@+id/txtspeeddistance"
                       android:textColor="@color/AppBlackColor" />

               </RelativeLayout>
           </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_sensor_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/card_sensor_name"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/txt_sensor_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="5dp"
                        android:layout_toStartOf="@+id/img_battery"
                        android:text="TICKRX80c4"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_regular" />



                    <ImageView
                        android:id="@+id/img_battery"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_toStartOf="@+id/txt_battery_persentage"
                        android:src="@drawable/ic_battery_20"/>

                    <TextView
                        android:id="@+id/txt_battery_persentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_toStartOf="@+id/img_signal"
                        android:text="100%"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_regular" />

                    <ImageView
                        android:id="@+id/img_signal"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_toStartOf="@+id/img_ble"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_signal_75"/>

                    <ImageView
                        android:id="@+id/img_ble"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="5dp"
                        android:src="@drawable/ic_bluetooth_blue" />

                    <View
                        android:id="@+id/view1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:layout_below="@+id/img_signal"
                        android:background="@color/AppLightGrayColor"/>

                    <TextView
                        android:id="@+id/txt_sensor_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_toStartOf="@+id/img_heart_rate"
                        android:layout_below="@+id/view1"
                        android:text="HEART RATE"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_regular" />

                    <ImageView
                        android:id="@+id/img_heart_rate"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_below="@+id/view1"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_toStartOf="@+id/txt_ratecount"
                        android:src="@drawable/ic_heartrate"/>


                    <TextView
                        android:id="@+id/txt_ratecount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_toStartOf="@+id/txt_bpm"
                        android:layout_below="@+id/view1"
                        android:text="49"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_regular" />

                    <TextView
                        android:id="@+id/txt_bpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_alignParentRight="true"
                        android:layout_below="@+id/view1"
                        android:text="BPM"
                        android:textColor="@color/AppTextGrayColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/omnes_regular" />


                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="2dp"
                        android:layout_below="@+id/txt_sensor_type"
                        android:background="@color/AppLightGrayColor"/>


                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/lay_Skip_go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:background="@color/AppLightGrayColor"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvforgetsensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_btn"
                    android:backgroundTint="@color/AppRedColor"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/forgetsensor"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="16sp"
                    android:fontFamily="@font/omnes_semibold_regular" />

                <TextView
                    android:id="@+id/tvsave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_btn"
                    android:backgroundTint="@color/AppMainColor"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/save"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="16sp"
                    android:fontFamily="@font/omnes_semibold_regular" />


            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>
</layout>