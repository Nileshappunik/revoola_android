<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ride">

        <ImageView
            android:id="@+id/img_cancle"
            android:layout_width="30dp"
            android:layout_height="35dp"
           android:layout_alignParentRight="true"
            android:scaleType="fitXY"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_cancel"/>


        <ImageView
            android:id="@+id/img_done"
            android:layout_width="50dp"
            android:layout_height="50dp"
           android:layout_centerHorizontal="true"
            android:layout_below="@+id/img_cancle"
            android:padding="10dp"
            android:background="@drawable/full_round"
            android:src="@drawable/ic_check_g_right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_below="@+id/img_done"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:textStyle="bold"
                android:background="@null"
                android:text="@string/sessioncomplete"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="35sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:background="@null"
                android:text="@string/ridesession"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="35sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:cardCornerRadius="5dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">
                    <TextView
                        android:id="@+id/txtpersonal_session"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:text="@string/personaliseyoursessiobn"
                        android:textAlignment="textStart"
                        android:textColor="@color/green"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/txtname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:layout_below="@+id/txtpersonal_session"
                        android:text="@string/name"
                        android:textAlignment="textStart"
                        android:textColor="@color/green"
                        android:textSize="16sp"/>
                    <EditText
                        android:id="@+id/edtname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:textStyle="normal"
                        android:background="@null"
                        android:textColorHint="@color/Gray"
                        android:layout_toEndOf="@+id/txtname"
                        android:layout_marginStart="5dp"
                        android:layout_below="@+id/txtpersonal_session"
                        android:hint="@string/giveyoursessionname"
                        android:textAlignment="textStart"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

                    <View
                        android:id="@+id/viewsession1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/Gray"
                        android:layout_below="@id/edtname"
                        android:layout_marginTop="8dp"/>

                    <ImageView
                        android:id="@+id/imgedit1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_below="@+id/viewsession1"
                        android:src="@drawable/ic_edit"/>
                    <TextView
                        android:id="@+id/txtphotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:textStyle="normal"
                        android:background="@null"
                        android:layout_toEndOf="@+id/txtname"
                        android:layout_marginStart="5dp"
                        android:layout_below="@+id/viewsession1"
                        android:text="@string/addupto5photos"
                        android:textAlignment="textStart"
                        android:textColor="@color/Gray"
                        android:textSize="16sp"/>

                    <View
                        android:id="@+id/viewsession2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/Gray"
                        android:layout_below="@id/txtphotos"
                        android:layout_marginTop="8dp"/>

                    <ImageView
                        android:id="@+id/imgedit2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_below="@+id/viewsession2"
                        android:src="@drawable/ic_edit"/>

                    <EditText
                        android:id="@+id/edtnotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:textStyle="normal"
                        android:background="@null"
                        android:textColorHint="@color/Gray"
                        android:layout_toEndOf="@+id/txtname"
                        android:layout_marginStart="5dp"
                        android:layout_below="@+id/viewsession2"
                        android:hint="@string/addnotes"
                        android:textAlignment="textStart"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>


                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/txtwhocansee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textStyle="normal"
                        android:background="@null"
                        android:layout_marginStart="5dp"
                        android:text="@string/whocanseeyouractivity"
                        android:textAlignment="textStart"
                        android:textColor="@color/Gray"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:id="@+id/lay_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/round_border_white"
                        android:backgroundTint="@color/lightnavyblue"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/img_shareimage"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_privacyfriends"/>
                        <TextView
                            android:id="@+id/tvsharetitle"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/friendstx"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/navyblue"
                            android:textSize="18sp"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtsharemap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:textStyle="normal"
                        android:background="@null"
                        android:layout_below="@+id/txtwhocansee"
                        android:layout_marginStart="5dp"
                        android:text="@string/sharemap"
                        android:textAlignment="textStart"
                        android:textColor="@color/Gray"
                        android:textSize="16sp"/>



                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCompat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_below="@+id/lay_privacy"
                        app:thumbTint="@color/white"
                        android:checked="true"
                        app:track="@drawable/custom_track"/>


                </RelativeLayout>

            </androidx.cardview.widget.CardView>



        </LinearLayout>


        <TextView
            android:id="@+id/tvsave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/save"
            android:background="@drawable/full_round_green"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="normal" />

    </RelativeLayout>

</layout>