<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null">
        <LinearLayout
            android:layout_width="wrap_content"
            android:background="@null"
            android:layout_height="50dp"
            android:layout_alignParentRight="false">
            <TextView
                android:id="@+id/txt_srno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_gravity="center_vertical"
                android:textSize="10sp"
                android:fontFamily="@font/omnes_regular"
                android:text="10"
                android:textColor="@color/AppWhiteColor"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_friend"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="5dp"
                android:layout_gravity="center_vertical"
                android:scaleType="fitXY"
                app:shapeAppearance="@style/CornerRound"
                android:src="@drawable/wellcome"/>

            <ImageView
                android:id="@+id/img_country_flag"
                android:layout_width="10dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/indian_flag"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/txt_friend_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_gravity="center_vertical"
                android:text="DHRUV90"
                android:fontFamily="@font/omnes_regular"
                android:textStyle="bold"
                android:textColor="@color/AppWhiteColor"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/txt_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:textSize="10sp"
                android:fontFamily="@font/omnes_regular"
                android:text="10"
                android:textColor="@color/AppWhiteColor"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:shapeAppearance="@style/CornerRound"
                android:background="@color/AppZone2Color"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>
    </RelativeLayout>

</layout>
