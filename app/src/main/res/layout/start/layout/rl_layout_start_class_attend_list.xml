<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_attendlist"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@null">
            <TextView
                android:id="@+id/txt_srno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_centerVertical="true"
                android:textSize="10sp"
                android:fontFamily="@font/omnes_regular"
                android:text="10"
                android:textColor="@color/AppWhiteColor"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_friend"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="5dp"
               android:layout_centerVertical="true"
                android:scaleType="fitXY"
                android:layout_toEndOf="@+id/txt_srno"
                app:shapeAppearance="@style/CornerRound"
                android:src="@drawable/wellcome"/>

            <ImageView
                android:id="@+id/img_country_flag"
                android:layout_width="10dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:scaleType="fitXY"
                android:layout_toEndOf="@+id/img_friend"
                android:src="@drawable/indian_flag"
               android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/txt_friend_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
               android:layout_centerVertical="true"
                android:text="DHRUV90"
                android:layout_toEndOf="@+id/img_country_flag"
               android:layout_toStartOf="@+id/txt_count"
                android:fontFamily="@font/omnes_regular"
                android:textStyle="bold"
                android:textColor="@color/AppWhiteColor"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/txt_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
               android:layout_centerVertical="true"
                android:textSize="10sp"
                android:layout_toStartOf="@+id/img_dot"
                android:fontFamily="@font/omnes_regular"
                android:text="10"
                android:textColor="@color/AppWhiteColor"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentRight="true"
                app:shapeAppearance="@style/CornerRound"
                android:background="@color/AppZone2Color"
               android:layout_centerVertical="true"/>

    </RelativeLayout>

</layout>
