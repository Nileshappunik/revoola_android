<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/AppWhiteColor"
        android:padding="10dp"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/card_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/icon_help_challenges"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/fd_steps_green"/>

            <TextView
                android:id="@+id/txt_header"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/omnes_semibold_regular"
                android:layout_toEndOf="@+id/icon_help_challenges"
                android:text="@string/stepsmall"
                android:textColor="@color/AppMainColor"/>

            <TextView
                android:id="@+id/tv_Description_challenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/txt_header"
                android:fontFamily="@font/omnes_regular"
                android:textColor="@color/AppBlackColor"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textAllCaps="true"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"/>

        <TextView
            android:id="@+id/tv_Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="@android:color/holo_blue_light"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/omnes_regular"
            android:textColor="@color/AppBlackColor"/>

    </LinearLayout>

</layout>