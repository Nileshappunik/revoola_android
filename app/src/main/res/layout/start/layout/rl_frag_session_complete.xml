<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/walk">

        <ImageView
            android:id="@+id/img_cancle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:scaleType="fitXY"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_cancel"/>


       <!-- <ImageView
            android:id="@+id/img_done"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="100dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/img_cancle"
            android:padding="10dp"
            android:background="@drawable/full_round"
            android:src="@drawable/ic_check_g_right"/>-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="bottom"
            android:layout_above="@+id/tvSave"
            android:layout_below="@+id/img_cancle"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_done1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="100dp"
                android:layout_gravity="center_horizontal"
                android:padding="10dp"
                android:background="@drawable/full_round"
                android:src="@drawable/ic_check_g_right"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:background="@null"
                android:textAllCaps="true"
                android:text="@string/workoutcomplete"
                android:textAlignment="center"
                android:textColor="@color/AppWhiteColor"
                android:textSize="26sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:background="@null"
                android:text="@string/ridesession"
                android:visibility="gone"
                android:textAlignment="textStart"
                android:textColor="@color/AppWhiteColor"
                android:textSize="26sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                app:cardCornerRadius="5dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">
                    <TextView
                        android:id="@+id/txtPersonalSession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:background="@null"
                        android:text="@string/personaliseyoursessiobn"
                        android:textAlignment="textStart"
                        android:textColor="@color/AppMainColor"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtname"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:background="@null"
                        android:layout_below="@+id/txtPersonalSession"
                        android:text="@string/name"
                        android:textAllCaps="true"
                        android:textAlignment="textStart"
                        android:textColor="@color/AppMainColor"
                        android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/edtSessionName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/omnes_regular"
                        android:background="@null"
                        android:singleLine="true"
                        android:textColorHint="@color/AppBottomGrayColor"
                        android:layout_toEndOf="@+id/txtname"
                        android:layout_below="@+id/txtPersonalSession"
                        android:hint="@string/name"
                        android:textAlignment="textStart"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="14sp"
                        android:inputType="text" />

                    <View
                        android:id="@+id/viewSession1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/AppLightGrayColor"
                        android:layout_below="@id/edtSessionName"
                        android:layout_marginTop="20dp"/>
                    <RelativeLayout
                        android:id="@+id/relativeAddPhotos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_below="@+id/viewSession1">
                        <ImageView
                            android:id="@+id/iconGallery"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_photo1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/omnes_regular"
                            android:background="@null"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/iconGallery"
                            android:layout_marginStart="30dp"
                            android:textAllCaps="true"
                            android:text="@string/addupto5photos"
                            android:textAlignment="textStart"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="14sp"/>

                    </RelativeLayout>

                    <View
                        android:id="@+id/viewSession2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/AppLightGrayColor"
                        android:layout_below="@id/relativeAddPhotos"
                        android:layout_marginTop="20dp"/>

                    <RelativeLayout
                        android:id="@+id/relativeAddNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_below="@+id/viewSession2">
                        <ImageView
                            android:id="@+id/iconEdit"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_edit"/>

                        <EditText
                            android:id="@+id/edtAddNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/omnes_regular"
                            android:background="@null"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/iconEdit"
                            android:layout_marginStart="30dp"
                            android:hint="@string/addnotes"
                            android:textAlignment="textStart"
                            android:textColor="@color/AppTextGrayColor"
                            android:textSize="14sp"/>

                    </RelativeLayout>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/txtPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:background="@null"
                        android:text="@string/privacy"
                        android:textAllCaps="true"
                        android:textAlignment="textStart"
                        android:textColor="@color/AppMainColor"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtWhoCanSee"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:background="@null"
                        android:textAllCaps="true"
                        android:gravity="center_vertical"
                        android:layout_below="@+id/txtPrivacy"
                        android:text="@string/whocanseethispost"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp"/>
                    <LinearLayout
                        android:id="@+id/layPrivacy"
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@+id/txtPrivacy"
                        android:background="@drawable/round_border_white"
                        android:backgroundTint="@color/AppPrivacyFriendsBGColor"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/imgShareImage"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="10dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_privacyfriends"/>
                        <TextView
                            android:id="@+id/tvShareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/friends"
                            android:layout_marginStart="5dp"
                            android:textAllCaps="true"
                            android:gravity="center_vertical"
                            android:textColor="@color/AppPrivacyFriendsColor"
                            android:textSize="14sp"
                            android:fontFamily="@font/omnes_semibold_regular" />
                    </LinearLayout>


                    <TextView
                        android:id="@+id/txtShareMap"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/omnes_semibold_regular"
                        android:background="@null"
                        android:layout_below="@+id/layPrivacy"
                        android:text="@string/sharemap"
                        android:textAllCaps="true"
                        android:gravity="center_vertical"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="16sp"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCompat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@+id/layPrivacy"
                        app:thumbTint="@color/AppWhiteColor"
                        android:checked="true"
                        app:track="@drawable/custom_track"/>


                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/save"
            android:background="@drawable/full_round_green"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/AppWhiteColor"
            android:textSize="14sp"
            android:fontFamily="@font/omnes_regular" />
    </RelativeLayout>

</layout>