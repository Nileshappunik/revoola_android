<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:text="@string/foryourmindandbody"
            android:textColor="@color/AppBlackColor"
            android:textSize="32sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:text="@string/whatdoyouwanttoday"
            android:textColor="@color/AppBlackColor"
            android:textSize="18sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp"
            android:orientation="vertical"
            android:weightSum="4">
            <include
                android:id="@+id/inlay_mindclass"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_bodyclass"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_yourway"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                layout="@layout/rl_layout_start_menu"/>
            <include
                android:id="@+id/inlay_challenges"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                layout="@layout/rl_layout_start_menu"/>
        </LinearLayout>



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rv_start"
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:layout_marginStart="5dp"
               android:layout_marginEnd="5dp"
               android:layout_marginTop="30dp"/>

        </RelativeLayout>
    </LinearLayout>
</layout>