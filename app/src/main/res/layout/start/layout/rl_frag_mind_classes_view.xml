<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/inlay_Button">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_main_banner"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:padding="3dp"
                    app:tint="@color/AppMainColor"
                    android:src="@drawable/ic_chevron_left"/>

                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:textSize="32sp"
                    android:textAllCaps="true"
                    android:layout_below="@+id/ivBack"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppWhiteColor"
                    android:gravity="start"/>
                <TextView
                    android:id="@+id/txt_with"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="3dp"
                    android:textSize="14sp"
                    android:textAllCaps="true"
                    android:layout_below="@+id/txt_title"
                    android:text="@string/with"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppWhiteColor"
                    android:gravity="start"/>
                <TextView
                    android:id="@+id/txt_namewith"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_toEndOf="@+id/txt_with"
                    android:textSize="14sp"
                    android:textAllCaps="true"
                    android:layout_below="@+id/txt_title"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppWhiteColor"
                    android:gravity="start"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/txt_namewith"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:id="@+id/linearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:weightSum="4">
                        <include
                            android:id="@+id/inlay_schdual"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            layout="@layout/rl_layout_mind_classes_schdule"/>

                        <include
                            android:id="@+id/inlay_download"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            layout="@layout/rl_layout_mind_classes_schdule"/>
                        <include
                            android:id="@+id/inlay_favourite"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            layout="@layout/rl_layout_mind_classes_schdule"/>
                        <include
                            android:id="@+id/inlay_share"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            layout="@layout/rl_layout_mind_classes_schdule"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/card_1"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:id="@+id/lay_timevideo"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:weightSum="2">
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/img_minutes"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_centerVertical="true"
                                    app:tint="@color/AppBlackColor"
                                    android:src="@drawable/fd_active_time_green"/>
                                <TextView
                                    android:id="@+id/txt_minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:textSize="12sp"
                                    android:textAllCaps="true"
                                    android:textStyle="bold"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@+id/img_minutes"
                                    android:fontFamily="@font/omnes_regular"
                                    android:textColor="@color/AppTextGrayColor"
                                    android:gravity="start"/>

                            </RelativeLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="@color/AppLightGrayColor"/>
                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:gravity="center_horizontal"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/img_video"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_centerVertical="true"
                                    android:layout_toEndOf="@+id/txt_video"
                                    android:src="@drawable/ic_video"/>
                                <TextView
                                    android:id="@+id/txt_video"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:textSize="12sp"
                                    android:textAllCaps="true"
                                    android:textStyle="bold"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/omnes_regular"
                                    android:textColor="@color/AppTextGrayColor"
                                    android:gravity="start"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <View
                            android:id="@+id/view_timevideo"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_below="@+id/lay_timevideo"
                            android:background="@color/AppLightGrayColor"/>
                        <LinearLayout
                            android:id="@+id/lay_worklog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_below="@+id/view_timevideo"
                            android:layout_margin="10dp"
                            android:weightSum="3">
                            <include
                                android:id="@+id/inlay_warmup"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                layout="@layout/rl_layout_mind_classes_warmup"/>
                            <include
                                android:id="@+id/inlay_workout"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                layout="@layout/rl_layout_mind_classes_warmup"/>
                            <include
                                android:id="@+id/inlay_cooldown"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                layout="@layout/rl_layout_mind_classes_warmup"/>

                        </LinearLayout>
                    </RelativeLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/card_2"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="15dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txt_video_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppBlackColor"
                            android:gravity="start"/>
                        <TextView
                            android:id="@+id/txt_video_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textSize="16sp"
                           android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppBlackColor"
                            android:gravity="start"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/card_3"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txt_trainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:layout_marginEnd="10dp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:layout_toStartOf="@+id/img_traner"
                            android:text="@string/trainer"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppTextGrayColor"/>

                        <TextView
                            android:id="@+id/txt_trainer_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:textAllCaps="true"
                            android:layout_toStartOf="@+id/img_traner"
                            android:layout_below="@+id/txt_trainer"
                            android:fontFamily="@font/omnes_regular"
                            android:textStyle="bold"
                            android:textColor="@color/AppBlackColor"/>

                        <TextView
                            android:id="@+id/txt_total_class"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:layout_toStartOf="@+id/img_traner"
                            android:layout_below="@+id/txt_trainer_name"
                            android:fontFamily="@font/omnes_regular"
                            android:textColor="@color/AppTextGrayColor"/>

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/img_traner"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:background="@color/AppWhiteColor"
                    android:layout_below="@+id/card_4"/>

            </RelativeLayout>
        </ScrollView>

        <include
            android:id="@+id/inlay_Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_size"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_alignParentBottom="true"
            layout="@layout/rl_layout_common_button"/>
       <!-- <TextView
            android:id="@+id/btn_startclass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_size"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textSize="@dimen/button_text_size"
            android:text="@string/startclass"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppWhiteColor"
            android:gravity="center"
            android:backgroundTint="@color/AppZone3Color"
            android:layout_alignParentBottom="true"
            android:background="@drawable/all_button_round_green"/>-->
    </RelativeLayout>

</layout>
