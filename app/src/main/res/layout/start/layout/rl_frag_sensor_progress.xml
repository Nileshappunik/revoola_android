<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ride">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent50"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_maintitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:background="@null"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                android:text="@string/ride"
                android:textAlignment="center"
                android:textColor="@color/AppWhiteColor"
                android:textSize="22sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@null"
                android:fontFamily="@font/omnes_regular"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                android:text="@string/inprogress"
                android:textAlignment="center"
                android:textColor="@color/AppLightGrayColor"
                android:textSize="20sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="25dp"
                android:background="@color/AppBottomGrayColor"/>

            <include
                android:id="@+id/inlay_time"
                layout="@layout/rl_common_sensor_progress" />

            <include
                android:id="@+id/inlay_cadence"
                layout="@layout/rl_common_sensor_progress"/>

            <include
                android:id="@+id/inlay_distance"
                layout="@layout/rl_common_sensor_progress"/>

            <include
                android:id="@+id/inlay_speed"
                layout="@layout/rl_common_sensor_progress"/>

            <include
                android:id="@+id/inlay_pace"
                layout="@layout/rl_common_sensor_progress"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:visibility="visible"
            android:gravity="center"
            android:background="@drawable/round_border_white"
            android:backgroundTint="@color/AppDarkGrayColor"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_pause"/>
            <TextView
                android:id="@+id/tvpause"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/pause"
                android:layout_marginStart="3dp"
                android:gravity="center_vertical"
                android:textColor="@color/AppWhiteColor"
                android:textSize="14sp"
                android:fontFamily="@font/omnes_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_resumestop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:weightSum="2">
            <LinearLayout
                android:id="@+id/lay_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="5dp"
                android:background="@drawable/round_border_white"
                android:backgroundTint="@color/AppDarkGrayColor"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_play"/>
                <TextView
                    android:id="@+id/tvresume"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:fontFamily="@font/omnes_regular"
                    android:text="@string/resume"
                    android:layout_marginStart="3dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lay_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="5dp"
                android:background="@drawable/round_border_white"
                android:backgroundTint="@color/AppScheduleWinColor"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_stop"/>
                <TextView
                    android:id="@+id/tvstop"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="@string/stop"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/omnes_regular"
                    android:gravity="center_vertical"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/countdown_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppBlackColor"
            android:gravity="center"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textSize="50sp"
            android:textColor="@color/AppWhiteColor"/>

    </RelativeLayout>

</layout>