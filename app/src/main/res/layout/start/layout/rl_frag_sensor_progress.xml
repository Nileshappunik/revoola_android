<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/relaytiveMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ride">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppBlack80Color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:orientation="vertical">

            <include
                android:id="@+id/inlayTop"
                layout="@layout/rl_layout_common_start_top"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:weightSum="2">
                <include
                    android:id="@+id/inlay_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress" />

                <include
                    android:id="@+id/inlay_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:weightSum="2">
                <include
                    android:id="@+id/inlay_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress" />

                <include
                    android:id="@+id/inlay_climbed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:weightSum="2">
                <include
                    android:id="@+id/inlay_pace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress" />

                <include
                    android:id="@+id/inlay_speed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    layout="@layout/rl_common_sensor_progress"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:visibility="visible"
            android:gravity="center"
            android:background="@drawable/round_border_white"
            android:backgroundTint="@color/AppDarkGrayColor"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_pause"/>
            <TextView
                android:id="@+id/tvpause"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/pause"
                android:layout_marginStart="3dp"
                android:gravity="center_vertical"
                android:textColor="@color/AppWhiteColor"
                android:textSize="14sp"
                android:fontFamily="@font/omnes_semibold_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_resumestop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight= "10dp"
            android:weightSum="3">
            <LinearLayout
                android:id="@+id/lay_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:layout_margin="5dp"
                android:background="@drawable/round_border_white"
                android:backgroundTint="@color/AppDarkGrayColor"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_play"/>
                <TextView
                    android:id="@+id/tvresume"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:text="@string/resume"
                    android:layout_marginStart="3dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lay_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="5dp"
                android:background="@drawable/round_border_white"
                android:backgroundTint="@color/AppScheduleWinColor"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_stop"/>
                <TextView
                    android:id="@+id/tvstop"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="@string/stop"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:gravity="center_vertical"
                    android:textColor="@color/AppWhiteColor"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relay_countDown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppBlack80Color">
            <TextView
                android:id="@+id/countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/omnes_semibold_regular"
                android:textSize="100sp"
                android:textColor="@color/AppWhiteColor"/>
        </RelativeLayout>



    </RelativeLayout>

</layout>