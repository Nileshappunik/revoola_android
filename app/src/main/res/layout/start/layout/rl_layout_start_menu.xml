<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_start_new"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_marginEnd="10dp"
            app:shapeAppearanceOverlay="@style/CornerCutfive"/>

        <ImageView
            android:id="@+id/img_right"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>

        <ImageView
            android:id="@+id/img_typeicon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_toEndOf="@+id/img_type"/>

        <TextView
            android:id="@+id/txt_typename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:fontFamily="@font/omnes_semibold_regular"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/img_typeicon"
            android:layout_toStartOf="@+id/img_right"
            android:textColor="@color/AppBlackColor"/>

        <TextView
            android:id="@+id/txt_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@+id/img_type"
            android:layout_toStartOf="@+id/img_right"
            android:layout_below="@+id/txt_typename"
            android:textColor="@color/AppBlackColor"
            android:fontFamily="@font/omnes_regular"/>


    </RelativeLayout>

</layout>