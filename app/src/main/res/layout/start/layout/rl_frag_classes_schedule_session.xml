<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">

        <include
            android:id="@+id/inlayTop"
            layout="@layout/rl_layout_common_start_top"/>

        <LinearLayout
            android:id="@+id/lay_lable_text"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/inlayTop"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/round_border_green"
            android:weightSum="2"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnFriend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/full_round_green"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:gravity="center"
                android:text="@string/friends"
                android:textColor="@color/AppWhiteColor"/>

            <TextView
                android:id="@+id/btnGroup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:gravity="center"
                android:text="@string/groups"
                android:textColor="@color/AppMainColor"/>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/relay_serch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lay_lable_text"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:text="@string/selectfriendforschedule"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="20dp"
                android:textAlignment="center"
                android:fontFamily="@font/omnes_regular"
                android:textSize="14sp"
                android:textColor="@color/AppBlackColor"/>
            <RelativeLayout
                android:id="@+id/rl_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/square_border_dark">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@null"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:hint="@string/enternamehere"
                    android:minHeight="40dp"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="16sp" />
            </RelativeLayout>
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnInvite"
            android:layout_below="@+id/relay_serch"/>


        <TextView
            android:id="@+id/btnInvite"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            android:background="@drawable/full_round_green"
            android:backgroundTint="@color/AppDarkGrayColor"
            android:fontFamily="@font/omnes_regular"
            android:gravity="center"
            android:text="@string/invite"
            android:textColor="@color/AppWhiteColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInviteClick"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            android:visibility="gone"
            android:background="@drawable/full_round_green"
            android:fontFamily="@font/omnes_regular"
            android:gravity="center"
            android:text="@string/invite"
            android:textColor="@color/AppWhiteColor"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

</layout>
