<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btn_invite">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_main_banner"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:src="@drawable/ride"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginStart="16dp"
                    android:padding="10dp"
                    android:background="@drawable/full_round"
                    android:src="@drawable/ic_back_g"/>

                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:textSize="32sp"
                    android:text="@string/invitefriendorgrouptosession"
                    android:layout_below="@+id/ivBack"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppWhiteColor"
                    android:gravity="start"/>

                <TextView
                    android:id="@+id/btn_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/friends"
                    android:layout_below="@+id/txt_title"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppMainColor"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:background="@drawable/rounded_corners"/>
                <TextView
                    android:id="@+id/btn_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="16dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/groups"
                    android:layout_below="@+id/txt_title"
                    android:layout_toEndOf="@+id/btn_friends"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:textColor="@color/AppMainColor"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:background="@drawable/rounded_corners"/>

                <EditText
                    android:id="@+id/edt_name_to_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_below="@+id/btn_friends"
                    android:background="@drawable/rounded_corners"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="@string/enternametosearch"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_below="@+id/edt_name_to_search"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_friends_group"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:background="@color/AppWhiteColor"
                    android:layout_below="@+id/card_1"/>

            </RelativeLayout>
        </ScrollView>
        <TextView
            android:id="@+id/btn_invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:text="@string/invite"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppWhiteColor"
            android:gravity="center"
            android:textSize="16sp"
            android:backgroundTint="@color/AppLightGrayColor"
            android:layout_alignParentBottom="true"
            android:background="@drawable/full_round_green"/>
    </RelativeLayout>

</layout>
