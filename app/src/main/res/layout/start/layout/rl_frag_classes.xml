<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppLightGrayColor">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:background="@drawable/full_round"
            android:src="@drawable/ic_back_g"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/ivBack">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/AppLightGrayColor"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:text="@string/foryourmindandbody"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/omnes_semibold_regular"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:text="@string/revoolaclasses"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="25sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/omnes_regular"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="35dp"
                    android:text="@string/whatwouldyouliketodotoday"
                    android:textColor="@color/AppTextGrayColor"
                    android:textSize="20sp"/>

                <include
                    android:id="@+id/lay_yourmind"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="10dp"
                    layout="@layout/rl_layout_start_list"/>

                <include
                    android:id="@+id/lay_yourbody"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="10dp"
                    layout="@layout/rl_layout_start_list"/>
            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</layout>
