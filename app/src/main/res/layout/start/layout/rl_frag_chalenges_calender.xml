<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">

        <include
            android:id="@+id/inlayTop"
            layout="@layout/rl_layout_common_start_top"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/square_border_black">
                    <TextView
                        android:id="@+id/tvFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="@string/from"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="0dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/previousMonthButtonFrom"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="@color/AppMainColor"/>

                        <TextView
                            android:id="@+id/monthYearTextViewFrom"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:text="JULY, 2024"
                            android:textAllCaps="true"
                            android:fontFamily="@font/aptos_bold"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="24sp" />


                        <ImageView
                            android:id="@+id/nextMonthButtonFrom"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/AppMainColor"/>
                    </LinearLayout>

                    <include
                        android:id="@+id/inlay_week_From"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        layout="@layout/rl_item_week_header"
                        android:layout_below="@+id/tvFrom"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/calendarRecyclerViewFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_week_From"
                        android:padding="16dp"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/square_border_black">
                    <TextView
                        android:id="@+id/tvTo"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="@string/to"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="0dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/previousMonthButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="@color/AppMainColor"/>

                        <TextView
                            android:id="@+id/monthYearTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:text="JULY, 2024"
                            android:fontFamily="@font/aptos_bold"
                            android:textAllCaps="true"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="24sp" />


                        <ImageView
                            android:id="@+id/nextMonthButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/AppMainColor"/>
                    </LinearLayout>

                    <include
                        android:id="@+id/inlay_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/rl_item_week_header"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_below="@+id/tvTo"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/calendarRecyclerViewTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_week"
                        android:padding="16dp"/>
                </RelativeLayout>


                <Button
                    android:id="@+id/btn_nextInvisible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_size"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="@dimen/button_text_size"
                    android:textColor="@color/AppBlackColor"
                    android:text="@string/next"
                    android:background="@drawable/round_border_black"/>
                <Button
                    android:id="@+id/btn_nextVisible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_size"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    android:textSize="@dimen/button_text_size"
                    android:textColor="@color/AppWhiteColor"
                    android:text="@string/next"
                    android:background="@drawable/round_green_thirty"/>

              <!--  <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@color/AppWhiteColor"/>-->
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>