<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:layout_marginStart="10dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"
                android:visibility="visible" />


            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:text="CHALLENGES"
                android:textColor="@color/AppBlackColor"
                android:textSize="28sp"
                android:fontFamily="@font/omnes_semibold_regular" />

            <ImageView
                android:id="@+id/ivhelp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="5dp"
                android:src="@drawable/info"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/tvpassupdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
           android:textAlignment="center"
            android:text="@string/typeofchallenge"
            android:textColor="@color/AppBlackColor"
            android:textAllCaps="true"
            android:textSize="14sp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/square_border_black">
                    <TextView
                        android:id="@+id/tvFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="@string/from"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="15dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/previousMonthButtonFrom"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="@color/AppMainColor"/>

                        <TextView
                            android:id="@+id/monthYearTextViewFrom"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:text="JULY, 2024"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="24sp" />


                        <ImageView
                            android:id="@+id/nextMonthButtonFrom"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/AppMainColor"/>
                    </LinearLayout>

                    <include
                        android:id="@+id/inlay_week_From"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        layout="@layout/rl_item_week_header"
                        android:layout_below="@+id/tvFrom"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/calendarRecyclerViewFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_week_From"
                        android:padding="16dp"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/square_border_black">
                    <TextView
                        android:id="@+id/tvTo"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="@string/to"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:textColor="@color/AppBlackColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/omnes_semibold_regular" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="15dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/previousMonthButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="@color/AppMainColor"/>

                        <TextView
                            android:id="@+id/monthYearTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:text="JULY, 2024"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/AppBlackColor"
                            android:textSize="24sp" />


                        <ImageView
                            android:id="@+id/nextMonthButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/AppMainColor"/>
                    </LinearLayout>

                    <include
                        android:id="@+id/inlay_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/rl_item_week_header"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_below="@+id/tvTo"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/calendarRecyclerViewTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/inlay_week"
                        android:padding="16dp"/>
                </RelativeLayout>

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textColor="@color/AppBlackColor"
                    android:text="@string/next"
                    android:background="@drawable/round_border_black"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@color/AppWhiteColor"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>