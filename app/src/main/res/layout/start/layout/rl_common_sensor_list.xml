<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_heartratesensor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp">

            <TextView
                android:id="@+id/txt_sensor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="16sp"
                android:fontFamily="@font/omnes_regular" />

            <ImageView
                android:id="@+id/img1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_below="@+id/txt_sensor_title"
                android:layout_marginTop="30dp"
                android:src="@drawable/ic_heartrate"/>


            <ImageView
                android:id="@+id/img_edit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:layout_below="@+id/txt_sensor_name"
                android:layout_toStartOf="@+id/img_done"
                android:src="@drawable/ic_pen_g"/>


            <ImageView
                android:id="@+id/img_done"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_below="@+id/txt_sensor_name"
                android:layout_alignParentRight="true"
                android:src="@drawable/ic_checkboxchecked"/>

            <ImageView
                android:id="@+id/img_signal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/txt_sensor_name"
                android:layout_toEndOf="@+id/img1"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_signal_75"/>

            <ImageView
                android:id="@+id/img_battery"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/txt_sensor_name"
                android:layout_toEndOf="@+id/img_signal"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_battery_20"/>
            <ImageView
                android:id="@+id/img_ble"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_below="@+id/txt_sensor_name"
                android:layout_toEndOf="@+id/img_battery"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_bluetooth_blue"/>

            <TextView
                android:id="@+id/txt_sensor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="25dp"
                android:layout_toEndOf="@+id/img1"
                android:layout_below="@+id/txt_sensor_title"
                android:textColor="@color/AppBlackColor"
                android:textSize="16sp"
                android:fontFamily="@font/omnes_regular" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:layout_below="@+id/img_signal"
                android:background="@color/AppBottomGrayColor"/>


        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</layout>