<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:paddingBottom="5dp"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/img1"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:backgroundTint="@color/AppLightGrayColor"
            android:background="@drawable/full_round"
            android:padding="10dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_heartrate"/>


        <ImageView
            android:id="@+id/img_edit"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:layout_below="@+id/txt_sensor_name"
            android:layout_toStartOf="@+id/img_done"
            android:src="@drawable/ic_pen_g"/>


        <ImageView
            android:id="@+id/img_done"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/txt_sensor_name"
            android:layout_alignParentRight="true"
            android:src="@drawable/ic_checkboxchecked"/>

        <ImageView
            android:id="@+id/img_signal"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_below="@+id/txt_sensor_name"
            android:layout_toEndOf="@+id/img1"
            android:layout_marginStart="15dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_signal_75"/>

        <ImageView
            android:id="@+id/img_battery"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_below="@+id/txt_sensor_name"
            android:layout_toEndOf="@+id/img_signal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_battery_20"/>
        <ImageView
            android:id="@+id/img_ble"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_below="@+id/txt_sensor_name"
            android:layout_toEndOf="@+id/img_battery"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_bluetooth_blue"/>

        <TextView
            android:id="@+id/txt_sensor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_toEndOf="@+id/img1"
            android:textColor="@color/AppBlackColor"
            android:textSize="16sp"
            android:fontFamily="@font/omnes_regular" />


    </RelativeLayout>
</layout>