<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/relay_videoplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:background="@null"/>

        <include
            android:id="@+id/inlay_playStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            layout="@layout/rl_layout_play_stop_video_button"/>


        <RelativeLayout
            android:id="@+id/leftsideview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="100dp">

            <RelativeLayout
                android:id="@+id/animatedview"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/inlay_relaxation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/inlay_relaxed"
                    layout="@layout/rl_common_start_mind_class_with_sensor"/>

                <include
                    android:id="@+id/inlay_relaxed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/inlay_time"
                    layout="@layout/rl_common_start_mind_class_with_sensor"/>

                <include
                    android:id="@+id/inlay_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_alignParentBottom="true"
                    layout="@layout/rl_common_start_mind_class_with_sensor"/>
            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relay_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:visibility="gone"
            android:layout_toEndOf="@+id/leftsideview"
            android:layout_marginStart="30dp">
            <TextView
                android:id="@+id/txt_Video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/omnes_semibold_regular"
                android:background="@null"
                android:text="00:00"
                android:textColor="@color/AppWhiteColor"
                android:textSize="18sp"/>
            <ProgressBar
                android:id="@+id/seekbar_video"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:progress="0"
                android:max="100"
                android:layout_below="@+id/txt_Video_time"
                android:progressBackgroundTint="@color/transparent50"
                android:progressTint="@color/AppWhiteColor"
                android:indeterminate="false" />
        </RelativeLayout>

        <include
            android:id="@+id/inlay_countdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/rl_layout_countdown_mind"/>
    </RelativeLayout>


</layout>
