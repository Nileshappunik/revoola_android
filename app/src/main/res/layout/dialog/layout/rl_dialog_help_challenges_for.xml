<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:gravity="center"
            android:text="@string/info"
            android:fontFamily="@font/omnes_semibold_regular"
            android:textColor="@color/AppBlackColor"/>

        <ImageView
            android:id="@+id/tv_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="20dp"
            android:padding="3dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="15dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_times_close"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_title">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/AppWhiteColor"
                android:padding="10dp"
                android:orientation="vertical">


                <include
                    android:id="@+id/lay_you"
                    layout="@layout/rl_common_layout_help_dialog"/>

                <include
                    android:id="@+id/lay_friends"
                    layout="@layout/rl_common_layout_help_dialog"/>

                <include
                    android:id="@+id/lay_groups"
                    layout="@layout/rl_common_layout_help_dialog"/>

                <include
                    android:id="@+id/lay_groups_v_groups"
                    layout="@layout/rl_common_layout_help_dialog"/>

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>


</layout>
