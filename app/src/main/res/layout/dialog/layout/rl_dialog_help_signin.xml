<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent_dialog">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/rounded_dialog_background">

            <ImageView
                android:id="@+id/img_help"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:src="@drawable/ic_info"/>

            <TextView
                android:id="@+id/tv_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_below="@+id/img_help"
                android:textAlignment="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/omnes_regular"
                android:textAllCaps="true"
                android:text="@string/revoolaisafully"
                android:textColor="@color/AppBlackColor"/>

            <TextView
                android:id="@+id/tv_close"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/round_border_login"
                android:backgroundTint="@color/AppMainColor"
                android:gravity="center"
                android:textAllCaps="true"
                android:layout_below="@+id/tv_Title"
                android:text="@string/ok"
                android:textColor="@color/AppWhiteColor"
                android:textSize="18sp"
                android:fontFamily="@font/omnes_semibold_regular" />


        </RelativeLayout>
    </RelativeLayout>



</layout>
