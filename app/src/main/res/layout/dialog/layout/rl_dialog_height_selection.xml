<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@drawable/rounded_dialog_background"
android:orientation="vertical"
android:padding="0dp">

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Select Height"
    android:layout_marginTop="16dp"
    android:fontFamily="@font/omnes_semibold_regular"
    android:textSize="18sp"
    android:textColor="@android:color/black"
    android:gravity="center"/>

<RadioGroup
    android:id="@+id/radioGroup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginStart="16dp"
    android:orientation="vertical">

    <RadioButton
        android:id="@+id/radioButtonfeetandinches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/AppMainColor"
        android:text="@string/feetandinches" />

    <RadioButton
        android:id="@+id/radioButtonmetric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/AppMainColor"
        android:text="@string/metric" />



</RadioGroup>


    <RelativeLayout
        android:id="@+id/rv_poundmatric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">
        <NumberPicker
            android:id="@+id/numberPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rv_ukstones"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:padding="16dp">
        <NumberPicker
            android:id="@+id/numberPickerfeet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"/>

        <NumberPicker
            android:id="@+id/numberPickerinches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="30dp"/>

    </RelativeLayout>


<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="20dp"
    android:background="@color/AppDarkGrayColor" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:weightSum="2"
    android:background="@color/AppDarkGrayColor"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/tvNo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/cancle"
        android:textAllCaps="true"
        android:fontFamily="@font/omnes_regular"
        android:textSize="18sp"
        android:background="@color/AppWhiteColor"
        android:layout_marginEnd="1dp"
        android:textColor="@android:color/black"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvYes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/ok"
        android:textAllCaps="true"
        android:fontFamily="@font/omnes_regular"
        android:background="@color/AppWhiteColor"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:gravity="center"/>

</LinearLayout>

</LinearLayout>
