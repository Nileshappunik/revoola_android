<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="100dp"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/txtx_cancle"
        android:background="@drawable/square_border"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txt_selectGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/selectgroupcaps"
            android:textColor="@color/AppTextGrayColor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/omnes_regular" />

        <View
            android:id="@+id/view_grp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:background="@color/AppLightGrayColor"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtx_cancle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/square_border"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/AppBlackColor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/omnes_regular" />

</RelativeLayout>