<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="100dp"
    android:paddingBottom="100dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp">

    <LinearLayout
        android:id="@+id/listItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/square_border"
        android:orientation="vertical"
        android:layout_above="@+id/txtx_cancle">


        <TextView
            android:id="@+id/tvTitle_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="5dp"
            android:textAllCaps="true"
            android:fontFamily="@font/aptos_regular"
            android:text="@string/filters"
            android:textColor="@color/AppTextGrayColor"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@color/AppLightGrayColor"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtx_cancle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/square_border"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAllCaps="true"
        android:fontFamily="@font/aptos_regular"
        android:text="@string/cancelsmall"
        android:textColor="@color/AppBlackColor"
        android:textSize="16sp"/>

</RelativeLayout>