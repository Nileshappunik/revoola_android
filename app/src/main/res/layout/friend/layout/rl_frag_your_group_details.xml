<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">
        <include
            android:id="@+id/toolbar"
            layout="@layout/rl_toolbar_common" />

        <View
            android:id="@+id/view_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:background="@color/AppBlack10Color"/>

        <RelativeLayout
            android:id="@+id/relativeGroupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_1"
            android:layout_marginTop="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageGroup"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_centerVertical="true"
                android:scaleType="fitXY"
                app:shapeAppearance="@style/CornerRound"
                android:src="@drawable/sample_user"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/imageGroup"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtGroupName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:singleLine="true"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/txtGroupMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:singleLine="true"
                    android:layout_marginTop="5dp"
                    android:visibility="visible"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppTextGrayColor"
                    android:textSize="@dimen/text_size"/>
                <TextView
                    android:id="@+id/txtGroupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LABEL"
                    android:textAllCaps="true"
                    android:singleLine="true"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppTextGrayColor"
                    android:textSize="14sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFollowAll"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:visibility="visible"
                    android:textAllCaps="true"
                    android:background="@drawable/full_round_green"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:text="@string/followall"
                    android:textColor="@color/AppWhiteColor"/>

                <TextView
                    android:id="@+id/txtInviteAll"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:visibility="visible"
                    android:textAllCaps="true"
                    android:background="@drawable/round_border_green"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:text="@string/invitetojoin"
                    android:textColor="@color/AppMainColor"/>

                <TextView
                    android:id="@+id/txtRevoolaAll"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:visibility="visible"
                    android:textAllCaps="true"
                    android:background="@drawable/round_border_darkgray"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:text="@string/removeall"
                    android:textColor="@color/AppTextGrayColor"/>

            </LinearLayout>

        </RelativeLayout>

        <View
            android:id="@+id/view_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/relativeGroupInfo"
            android:background="@color/AppBlack10Color"/>
        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_2"
            android:background="@color/AppLightGrayColor">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="@color/AppBlack05Color"
                android:background="@drawable/round_green">

                <EditText
                    android:id="@+id/edtFriendSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search_g"
                    android:drawablePadding="10dp"
                    android:hint="@string/enternameemailtofindonrevoola"
                    android:minHeight="40dp"
                    android:textSize="16sp"
                    android:textColor="@color/AppBlackColor" />
            </RelativeLayout>
        </RelativeLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleYourfriend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/rl_search"/>

    </RelativeLayout>

</layout>