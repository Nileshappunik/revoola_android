<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppWhiteColor">
        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                app:tint="@color/AppMainColor"
                android:src="@drawable/ic_arrow_back_ios"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textAllCaps="true"
                android:fontFamily="@font/aptos_regular"
                android:gravity="center_vertical"
                android:layout_centerHorizontal="true"
                android:textColor="@color/AppBlackColor"
                android:textSize="16sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar"
            android:background="@color/AppTextLightGrayColor">

            <EditText
                android:id="@+id/edt_friend_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/round_green"
                android:backgroundTint="@color/AppLightGrayColor"
                android:drawableStart="@drawable/fr_search_green"
                android:drawablePadding="10dp"
                android:drawableTint="@color/AppTextGrayColor"
                android:hint="@string/enternameoremailtofindonrevoola"
                android:minHeight="40dp"
                android:paddingStart="10dp"
                android:textColor="@color/AppBlackColor" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/lay_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_search"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_seasrch"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/txt_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textAllCaps="true"
                android:fontFamily="@font/aptos_regular"
                android:layout_gravity="center_horizontal"
                android:text="@string/contacts"
                android:textColor="@color/AppBlackColor"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:background="@color/AppMainColor"/>
        </LinearLayout>

        <View
            android:id="@+id/view_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/lay_contact"
            android:background="@color/AppBottomGrayColor"/>

        <RelativeLayout
            android:id="@+id/relay_synccontact"
            android:layout_width="match_parent"
            android:layout_below="@+id/view_2"
            android:background="@color/AppWhiteColor"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/img_group"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:backgroundTint="@color/AppTextLightGrayColor"
                android:background="@drawable/full_round"
                android:layout_marginStart="10dp"
                android:padding="2dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_person"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:layout_toEndOf="@+id/img_group"
                android:layout_toStartOf="@+id/txt_sync_contact"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_group_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/synccontacts"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppBlackColor"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/txt_group_noofmembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alreadyusingrevoola"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/omnes_regular"
                    android:textColor="@color/AppTextGrayColor"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txt_sync_contact"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:background="@drawable/round_border_green"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:fontFamily="@font/omnes_regular"
                android:text="@string/sync"
                android:textColor="@color/AppMainColor"/>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/AppLightGrayColor"
                android:layout_alignParentBottom="true"/>

        </RelativeLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle_yourfriend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/view_bottom"
            android:layout_below="@+id/relay_synccontact"/>

        <TextView
            android:id="@+id/txt_inviteyourfriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:paddingStart="70dp"
            android:paddingEnd="70dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textAllCaps="true"
            android:background="@drawable/login_btn"
            android:backgroundTint="@color/AppMainColor"
            android:text="@string/invite"
            android:textColor="@color/AppWhiteColor"
            android:textSize="@dimen/text_title_size"
            android:fontFamily="@font/aptos_regular" />

        <TextView
            android:id="@+id/demo_invite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/txt_inviteyourfriend"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:text="@string/invitefriendsnotonyet"
            android:textColor="@color/AppBlackColor"
            android:textSize="16sp"
            android:fontFamily="@font/aptos_regular" />

        <View
            android:id="@+id/view_bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@+id/demo_invite"
            android:background="@color/AppBlackColor"/>


    </RelativeLayout>

</layout>