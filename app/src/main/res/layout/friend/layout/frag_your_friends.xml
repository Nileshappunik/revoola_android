<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_common" />

            <View
                android:id="@+id/view_1"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@+id/toolbar"
                android:background="@color/off_white"/>

        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_1"
            android:background="@color/Gray">

            <EditText
                android:id="@+id/edt_friend_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/round_green"
                android:backgroundTint="@color/lightGray"
                android:drawableStart="@drawable/fr_search_green"
                android:drawablePadding="10dp"
                android:drawableTint="@color/black"
                android:hint="@string/enternameoremailtofindonrevoola"
                android:minHeight="40dp"
                android:paddingStart="10dp"
                android:textColor="@color/black" />
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/lay_invite_common"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_search"

            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:weightSum="2"
            android:background="@drawable/full_round_border"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txt_friend_youfollow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/full_round_green"
                android:textAlignment="center"
                android:text="@string/friendsyoufollow"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/txt_friend_followingyou"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textAlignment="center"
                android:text="@string/friendsfollowingyou"
                android:textColor="@color/Gray"/>

        </LinearLayout>

        <View
            android:id="@+id/view_2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/lay_invite_common"
            android:layout_marginTop="10dp"
            android:background="@color/off_white"/>
        <TextView
            android:id="@+id/txt_friend_followcount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="10dp"
            android:background="@color/lightGray"
            android:textSize="12sp"
            android:text="@string/friendsyoufollow"
            android:textColor="@color/black"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycle_yourfriend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/demo_invite"
            android:layout_below="@+id/txt_friend_followcount"/>

        <TextView
            android:id="@+id/txt_inviteyourfriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/login_btn"
            android:backgroundTint="@color/green"
            android:padding="5dp"
            android:text="@string/invitefriends"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title_size"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/demo_invite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/txt_inviteyourfriend"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:text="@string/invitefriendsnotonyet"
            android:textColor="@color/Gray"
            android:textSize="@dimen/text_size"
            android:textStyle="normal" />


    </RelativeLayout>

</layout>