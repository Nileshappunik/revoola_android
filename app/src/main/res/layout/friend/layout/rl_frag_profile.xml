<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/AppLightGrayColor"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            app:tint="@color/AppMainColor"
            android:src="@drawable/ic_chevron_left"/>


        <TextView
            android:id="@+id/tvtitlesetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop= "10dp"
            android:layout_marginStart="20dp"
            android:textAllCaps="true"
            android:text="@string/profile"
            android:textColor="@color/AppBlackColor"
            android:textSize="26sp"
            android:fontFamily="@font/omnes_semibold_regular" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop= "10dp"
            android:background="@color/AppWhiteColor">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/AppWhiteColor"
                android:orientation="vertical">

                <include
                    android:id="@+id/lay_firstname"
                    layout="@layout/rl_common_layout_setting"/>

                <include
                    android:id="@+id/lay_surname"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_nickname"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_avatar"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_email"
                    layout="@layout/rl_common_layout_setting"/>


                <include android:id="@+id/lay_gender"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_dateofbirth"
                    layout="@layout/rl_common_layout_setting"/>

                <include
                    android:id="@+id/lay_weight"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_height"
                    layout="@layout/rl_common_layout_setting"/>

                <include
                    android:id="@+id/lay_maxheartrate"
                    layout="@layout/rl_common_layout_setting"/>

                <include
                    android:id="@+id/lay_restingheartrate"
                    layout="@layout/rl_common_layout_setting"/>


                <include
                    android:id="@+id/lay_Change_Your_Password"
                    layout="@layout/rl_common_layout_setting"/>

                <include
                    android:id="@+id/lay_Request_To_Delete_Your_Data"
                    layout="@layout/rl_common_layout_setting"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:background="@color/AppWhiteColor"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>