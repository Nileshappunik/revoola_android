<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp">

        <ImageView
            android:id="@+id/checkboxImage"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:button="@drawable/ic_checkbox_empty"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:visibility="gone"/>

        <CheckBox
            android:id="@+id/checkbox_friend"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:button="@drawable/custom_checkbox"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:visibility="gone"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_group"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:scaleType="fitXY"
            app:shapeAppearance="@style/CornerRound"
            android:src="@drawable/sample_user"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_toEndOf="@+id/img_group"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhruv Khatri"
                android:fontFamily="@font/omnes_regular"
                android:textColor="@color/AppBlackColor"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txt_group_membersince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Member Since:"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                android:fontFamily="@font/omnes_regular"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="@dimen/text_size"/>
            <TextView
                android:id="@+id/txt_group_noofmembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of Members:2"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/omnes_regular"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="14sp"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txt_group_member"
                android:layout_width="100dp"
                android:layout_height="35dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/round_border_green"
                android:textAllCaps="true"
                android:gravity="center"
                android:fontFamily="@font/omnes_regular"
                android:textAlignment="center"
                android:text="@string/members"
                android:textColor="@color/AppMainColor"/>

            <TextView
                android:id="@+id/txt_group_delete"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                android:visibility="gone"
                android:background="@drawable/round_border_green"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/delete"
                android:textColor="@color/AppMainColor"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppLightGrayColor"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="0dp"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</layout>
