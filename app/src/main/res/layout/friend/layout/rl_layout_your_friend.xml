<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90dp">

        <CheckBox
            android:id="@+id/checkbox_friend"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:button="@drawable/custom_checkbox"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:visibility="gone"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_friend"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:scaleType="fitXY"
            app:shapeAppearance="@style/CornerRound"
            android:src="@drawable/sample_user"/>


        <TextView
            android:id="@+id/txt_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/img_friend"
            android:text="Dhruv Khatri"
            android:fontFamily="@font/omnes_regular"
            android:textColor="@color/AppBlackColor"
            android:textSize="@dimen/text_title_size"/>

        <TextView
            android:id="@+id/txt_friend_unfollow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_border_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="true"
            android:fontFamily="@font/omnes_regular"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/unfollow"
            android:textColor="@color/AppMainColor"/>

        <View
            android:id="@+id/view_Friend"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/AppLightGrayColor"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="0dp"
            android:layout_alignParentBottom="true"/>

        <View
            android:id="@+id/view_selectFriend"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:background="@color/AppLightGrayColor"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</layout>
