<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/AppWhiteColor"
            android:orientation="vertical">
            <include
                android:id="@+id/toolbar"
                layout="@layout/rl_toolbar_common" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/invitefriendnotonrevoola"
                android:textColor="@color/AppTextGrayColor"
                android:textSize="20sp"
                android:fontFamily="@font/omnes_semibold_regular"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/AppLightGrayColor"/>

            <include
                android:id="@+id/lay_invite_facebook"
                layout="@layout/rl_layout_invite" />

            <include
                android:id="@+id/lay_invite_twitter"
                layout="@layout/rl_layout_invite" />

            <include
                android:id="@+id/lay_invite_whatsapp"
                layout="@layout/rl_layout_invite" />

            <include
                android:id="@+id/lay_invite_sms"
                layout="@layout/rl_layout_invite" />
            <include
                android:id="@+id/lay_invite_email"
                layout="@layout/rl_layout_invite" />

        </LinearLayout>

    </ScrollView>

</layout>