<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
    android:id="@+id/lay_invite_common"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:background="@drawable/square_border_green">
    <ImageView
        android:id="@+id/img_invite_common"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="1dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_facebook"/>

    <TextView
        android:id="@+id/txt_invite_common"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sendonfacebook"
        android:textColor="@color/AppTextGrayColor"
        android:layout_toEndOf="@+id/img_invite_common"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        android:textSize="20sp"/>
</RelativeLayout>

</layout>